{
  "id": "AH-CTK-149",
  "title": "§6.3.1: on_error deny (explicit) and an interceptor that returns a §5-invalid value: deny host_error:verdict_invalid, unchanged from §6.3",
  "spec_clause": "6.3, 6.3.1, 7.7.5, 10.3",
  "introduced_in": "draft",
  "part": "failure_posture/deny",
  "capabilities": [
    "model_calls",
    "tool_calls"
  ],
  "composition": {
    "profile": "sequential/run_all"
  },
  "scenario": {
    "input": {
      "content": "fetch",
      "role": "user"
    },
    "tools": [
      {
        "name": "http_get",
        "behavior": [
          {
            "return": "SECRET-RESULT"
          }
        ]
      }
    ],
    "model_script": [
      {
        "respond": {
          "content": null,
          "tool_calls": [
            {
              "id": "tc-1",
              "name": "http_get",
              "args": {
                "url": "https://x"
              }
            }
          ],
          "finish_reason": "tool_calls"
        }
      },
      {
        "respond": {
          "content": "done",
          "tool_calls": [],
          "finish_reason": "stop"
        }
      }
    ]
  },
  "interceptor_scripts": [
    [
      {
        "at": "pre_tool_call",
        "return": {
          "decision": "transform",
          "transform": {
            "path": "$target.missing.deep.path",
            "value": "x"
          }
        }
      }
    ],
    [
      {
        "at": "pre_tool_call",
        "return": {
          "decision": "allow",
          "reason": "ctk:should-not-run"
        }
      }
    ]
  ],
  "expect": {
    "sequence_strict": false,
    "interceptions": [
      {
        "interception_point": "pre_tool_call"
      }
    ],
    "interceptions_absent": [
      "post_tool_call"
    ],
    "tool_not_invoked": [
      "http_get"
    ],
    "records": [
      {
        "interception_point": "pre_tool_call",
        "assert": {
          "verdict.decision": "deny",
          "verdict.reason": "host_error:transform_invalid",
          "composition.profile": "sequential/run_all"
        }
      }
    ],
    "run_outcome": "completed",
    "run_outcome_by_posture": {
      "posture": "tool_seam_host_error",
      "outcomes": { "continue": "completed", "terminate": "blocked" }
    }
  }
}
