{
  "id": "AH-CTK-084",
  "title": "parallel/strictest: peers see the untransformed snapshot; the single winning transform applies",
  "spec_clause": "7.2, 7.5",
  "part": "composition/parallel_strictest",
  "capabilities": [
    "model_calls",
    "tool_calls"
  ],
  "composition": {
    "profile": "parallel/strictest"
  },
  "scenario": {
    "input": {
      "content": "go",
      "role": "user"
    },
    "tools": [
      {
        "name": "wire_transfer",
        "behavior": [
          {
            "return": "ok"
          }
        ]
      }
    ],
    "model_script": [
      {
        "respond": {
          "content": null,
          "tool_calls": [
            {
              "id": "tc-1",
              "name": "wire_transfer",
              "args": {
                "url": "dirty"
              }
            }
          ],
          "finish_reason": "tool_calls"
        }
      },
      {
        "respond": {
          "content": "sent",
          "tool_calls": [],
          "finish_reason": "stop"
        }
      }
    ]
  },
  "interceptor_scripts": [
    [
      {
        "at": "pre_tool_call",
        "return": {
          "decision": "transform",
          "transform": {
            "path": "$target.url",
            "value": "clean"
          }
        }
      }
    ],
    [
      {
        "at": "pre_tool_call",
        "match": {
          "tool_call.args.url": "clean"
        },
        "return": {
          "decision": "deny",
          "reason": "ctk:leaked-fold"
        }
      },
      {
        "at": "pre_tool_call",
        "return": {
          "decision": "allow"
        }
      }
    ]
  ],
  "expect": {
    "sequence_strict": false,
    "interceptions": [
      {
        "interception_point": "pre_tool_call",
        "context": {
          "tool_call.args.url": "dirty"
        }
      }
    ],
    "tool_invocations": [
      {
        "name": "wire_transfer",
        "args": {
          "url": "clean"
        }
      }
    ],
    "records": [
      {
        "interception_point": "pre_tool_call",
        "assert": {
          "verdict.decision": "transform",
          "decided_by": 0,
          "composition.profile": "parallel/strictest"
        }
      }
    ],
    "run_outcome": "completed",
    "identities_equal": false
  }
}
