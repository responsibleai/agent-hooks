{
  "id": "AH-CTK-093",
  "title": "§10.3: a transform-winning record keeps transform.path and drops transform.value",
  "spec_clause": "10.3, 5.2",
  "part": "record/projection",
  "capabilities": [
    "model_calls",
    "tool_calls"
  ],
  "scenario": {
    "input": {
      "content": "fetch",
      "role": "user"
    },
    "tools": [
      {
        "name": "http_get",
        "behavior": [
          {
            "return": "ok"
          }
        ]
      }
    ],
    "model_script": [
      {
        "respond": {
          "content": null,
          "tool_calls": [
            {
              "id": "tc-1",
              "name": "http_get",
              "args": {
                "url": "https://x"
              }
            }
          ],
          "finish_reason": "tool_calls"
        }
      },
      {
        "respond": {
          "content": "done",
          "tool_calls": [],
          "finish_reason": "stop"
        }
      }
    ]
  },
  "interceptor_script": [
    {
      "at": "pre_tool_call",
      "return": {
        "decision": "transform",
        "transform": {
          "path": "$target.url",
          "value": "https://safe"
        },
        "message": ""
      }
    }
  ],
  "expect": {
    "sequence_strict": false,
    "interceptions": [
      {
        "interception_point": "pre_tool_call"
      }
    ],
    "records": [
      {
        "interception_point": "pre_tool_call",
        "assert": {
          "verdict.decision": "transform",
          "verdict.transform.path": "$target.url"
        },
        "absent": [
          "verdict.transform.value"
        ]
      }
    ],
    "identities_equal": false,
    "run_outcome": "completed",
    "tool_invocations": [
      {
        "name": "http_get",
        "args": {
          "url": "https://safe"
        }
      }
    ]
  }
}
