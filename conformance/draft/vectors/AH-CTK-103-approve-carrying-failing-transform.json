{
  "id": "AH-CTK-144",
  "title": "Â§6.3.1: on_error deny (explicit) and a hanging interceptor: deny host_error:interceptor_timeout in the failing slot, tool not invoked",
  "spec_clause": "6.3, 6.3.1, 7.7.5, 10.3",
  "introduced_in": "draft",
  "part": "failure_posture/deny",
  "capabilities": [
    "model_calls",
    "tool_calls"
  ],
  "scenario": {
    "input": {
      "content": "fetch",
      "role": "user"
    },
    "tools": [
      {
        "name": "http_get",
        "behavior": [
          {
            "return": "SECRET-RESULT"
          }
        ]
      }
    ],
    "model_script": [
      {
        "respond": {
          "content": null,
          "tool_calls": [
            {
              "id": "tc-1",
              "name": "http_get",
              "args": {
                "url": "https://x"
              }
            }
          ],
          "finish_reason": "tool_calls"
        }
      },
      {
        "respond": {
          "content": "done",
          "tool_calls": [],
          "finish_reason": "stop"
        }
      }
    ]
  },
  "interceptor_script": [
    {
      "at": "pre_tool_call",
      "return": {
        "decision": "deny",
        "reason": "ctk:needs-approval",
        "approval": {}
      }
    }
  ],
  "approval_script": [
    {
      "resolve": {
        "outcome": "approve",
        "verdict": {
          "decision": "transform",
          "transform": {
            "path": "$target.missing.deep",
            "value": "x"
          }
        }
      }
    }
  ],
  "expect": {
    "sequence_strict": false,
    "interceptions": [
      {
        "interception_point": "pre_tool_call"
      }
    ],
    "interceptions_absent": [
      "post_tool_call"
    ],
    "tool_not_invoked": [
      "http_get"
    ],
    "records": [
      {
        "interception_point": "pre_tool_call",
        "assert": {
          "verdict.decision": "deny",
          "verdict.reason": "host_error:transform_invalid",
          "resolved_by": "approval"
        }
      }
    ],
    "run_outcome": "completed",
    "run_outcome_by_posture": {
      "posture": "tool_seam_host_error",
      "outcomes": { "continue": "completed", "terminate": "blocked" }
    }
  }
}
