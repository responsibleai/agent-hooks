{
  "id": "AH-CTK-105",
  "title": "on_approval=resume: every subsequently encountered liftable deny MUST be consulted in turn (§7.4)",
  "spec_clause": "7.4, 7.6",
  "part": "composition/sequential_first_deny",
  "capabilities": [
    "model_calls",
    "tool_calls"
  ],
  "composition": {
    "profile": "sequential/first_deny",
    "on_approval": "resume"
  },
  "scenario": {
    "input": {
      "content": "go",
      "role": "user"
    },
    "tools": [
      {
        "name": "wire_transfer",
        "behavior": [
          {
            "return": "ok"
          }
        ]
      }
    ],
    "model_script": [
      {
        "respond": {
          "content": null,
          "tool_calls": [
            {
              "id": "tc-1",
              "name": "wire_transfer",
              "args": {
                "url": "dirty"
              }
            }
          ],
          "finish_reason": "tool_calls"
        }
      },
      {
        "respond": {
          "content": "sent",
          "tool_calls": [],
          "finish_reason": "stop"
        }
      }
    ]
  },
  "interceptor_scripts": [
    [
      {
        "at": "pre_tool_call",
        "return": {
          "decision": "deny",
          "reason": "ctk:gate-a",
          "approval": {}
        }
      }
    ],
    [
      {
        "at": "pre_tool_call",
        "return": {
          "decision": "deny",
          "reason": "ctk:gate-b",
          "approval": {}
        }
      }
    ],
    [
      {
        "at": "pre_tool_call",
        "return": {
          "decision": "transform",
          "transform": {
            "path": "$target.url",
            "value": "twice-resumed"
          }
        }
      }
    ]
  ],
  "approval_script": [
    {
      "resolve": {
        "outcome": "approve",
        "verdict": {
          "decision": "allow"
        }
      }
    }
  ],
  "expect": {
    "sequence_strict": false,
    "interceptions": [
      {
        "interception_point": "pre_tool_call"
      }
    ],
    "tool_invocations": [
      {
        "name": "wire_transfer",
        "args": {
          "url": "twice-resumed"
        }
      }
    ],
    "records": [
      {
        "interception_point": "pre_tool_call",
        "assert": {
          "verdict.decision": "transform",
          "resolved_by": "approval",
          "fold_truncated": false,
          "composition.on_approval": "resume"
        }
      }
    ],
    "run_outcome": "completed",
    "identities_equal": false
  }
}
