{
  "$id": "https://responsibleai.github.io/agent-hooks/schema/v0.1/conformance/vectors.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks — CTK vector",
  "description": "Language-agnostic conformance test case (AGENT-HOOKS-0.1 §13.2). Scripts use the three-verdict vocabulary (§5): an escalation is a deny with an approval block; a warning is an allow with a warnings[] entry. Non-finite floats (NaN/Infinity) and lone surrogates cannot be expressed in a JSON vector file; those guards are pinned by per-SDK unit tests instead (§4.4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "spec_clause",
    "scenario",
    "expect"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^AH-CTK-[0-9]{3}(-[a-z0-9-]+)?$"
    },
    "title": {
      "type": "string"
    },
    "spec_clause": {
      "type": "string",
      "description": "Section of AGENT-HOOKS-0.1 this vector verifies."
    },
    "mode": {
      "type": "string",
      "enum": [
        "enforce",
        "evaluate_only"
      ],
      "default": "enforce",
      "description": "Enforcement mode the harness MUST set for this run (§8)."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "model_calls",
          "tool_calls",
          "parallel_tool_calls",
          "streaming",
          "multi_turn",
          "int64_json",
          "bigint_json",
          "buffered_output"
        ],
        "description": "int64_json marks vectors whose JSON carries integers beyond 2^53 (within i64/u64): a JavaScript harness cannot even load such a file without silent rounding (JSON.parse), so it omits the capability and skips. bigint_json marks vectors carrying integers beyond u64/i64, which additionally exceed serde_json's integer range — only harness languages whose JSON layer preserves raw numeric tokens (Python int, Go json.Number, .NET JsonNode) can claim it. buffered_output is declaration-only (§12.1a): it appears in a host's declared surface and claim, never as a vector requirement — the CTK's mocked I/O cannot exercise streaming egress."
      },
      "default": []
    },
    "scenario": {
      "$ref": "#/$defs/scenario"
    },
    "interceptor_script": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interceptor_rule"
      }
    },
    "approval_script": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval_rule"
      },
      "default": []
    },
    "expect": {
      "$ref": "#/$defs/expect"
    },
    "interceptor_scripts": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/interceptor_rule"
        }
      },
      "description": "Multi-interceptor form (§7.1 fold-through): one rule list per registered interceptor, in registration order. Mutually exclusive with interceptor_script. An empty array registers zero interceptors."
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "sequential/first_deny",
            "sequential/run_all",
            "parallel/strictest",
            "parallel/unanimous"
          ]
        },
        "on_approval": {
          "type": "string",
          "enum": [
            "stop",
            "resume"
          ]
        },
        "on_disagreement": {
          "type": "string",
          "enum": [
            "deny",
            "approval"
          ]
        },
        "on_transform_conflict": {
          "type": "string",
          "enum": [
            "deny",
            "approval"
          ]
        }
      },
      "description": "Composition profile the harness MUST declare for this run (§7.2). Absent means sequential/first_deny with on_approval: stop."
    },
    "identity_provider": {
      "enum": [
        "jcs-sha256",
        "ctk-fault",
        null
      ],
      "description": "Identity provider the harness MUST declare (§10.1). Absent means jcs-sha256; null means identity-unbound; \"ctk-fault\" means a custom provider named ctk-fault that fails on every compute (pins the §10.1 provider-failure rule). Other custom providers are functions and not vector-expressible."
    },
    "part": {
      "type": "string",
      "description": "Declared-surface tag (§13.1): grouping runner results by part is the conformance report (e.g. composition/parallel_strictest, approval_seam, identity_provider)."
    },
    "redact_for_approval": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\$target(\\.|\\[|$)"
      },
      "description": "§9 redaction seam: the harness MUST register an approval redactor that replaces each listed §5.2 path in the request context's target with the string \"[redacted]\" (write-back mirrored per §4.3). The request identity is computed over the redacted context."
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input"
      ],
      "properties": {
        "input": {
          "type": "object",
          "required": [
            "content",
            "role"
          ],
          "properties": {
            "content": true,
            "role": {
              "type": "string",
              "enum": [
                "user",
                "system",
                "external"
              ]
            }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "behavior"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "schema": {
                "type": "object"
              },
              "behavior": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "return"
                  ],
                  "properties": {
                    "when_args": {
                      "type": "object"
                    },
                    "return": true,
                    "is_error": {
                      "type": "boolean",
                      "default": false
                    }
                  }
                }
              }
            }
          },
          "default": []
        },
        "model_script": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "respond"
            ],
            "properties": {
              "respond": {
                "type": "object",
                "required": [
                  "content",
                  "tool_calls",
                  "finish_reason"
                ],
                "properties": {
                  "content": true,
                  "tool_calls": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "name",
                        "args"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "args": {
                          "type": "object"
                        }
                      }
                    }
                  },
                  "finish_reason": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "default": []
        }
      }
    },
    "interceptor_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at"
      ],
      "properties": {
        "at": {
          "$ref": "https://responsibleai.github.io/agent-hooks/schema/v0.1/interception-point.schema.json"
        },
        "match": {
          "type": "object",
          "additionalProperties": true,
          "description": "Dotted-path -> expected-value predicates against the AgentContext. All must match."
        },
        "return": {
          "$ref": "https://responsibleai.github.io/agent-hooks/schema/v0.1/verdict.schema.json"
        },
        "fault": {
          "type": "string",
          "enum": [
            "raise",
            "malformed_verdict",
            "mutate"
          ],
          "description": "Fault injection: 'raise' makes the scripted interceptor raise/throw natively (exercises §6.3 host_error:interceptor_failed); 'malformed_verdict' returns a §5-invalid shape (transform decision with no body; exercises host_error:verdict_invalid); 'mutate' makes the wrapper mutate the received context in-place and return allow (exercises §7 copy isolation, TM-05). Mutually exclusive with 'return'."
        }
      },
      "oneOf": [
        {
          "required": [
            "return"
          ]
        },
        {
          "required": [
            "fault"
          ]
        }
      ]
    },
    "approval_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolve"
      ],
      "properties": {
        "match": {
          "type": "object",
          "additionalProperties": true
        },
        "resolve": {
          "type": "object",
          "required": [],
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "approve",
                "reject",
                "unresolved"
              ]
            },
            "verdict": {
              "$ref": "https://responsibleai.github.io/agent-hooks/schema/v0.1/verdict.schema.json"
            },
            "fault": {
              "type": "string",
              "enum": [
                "raise"
              ],
              "description": "Fault injection: the scripted resolver raises/throws natively (exercises §6.3/§9 host_error:approval_resolver_failed). Mutually exclusive with 'outcome'."
            },
            "identity_override": {
              "type": "string",
              "description": "Return this context_identity instead of echoing the request's (violates the §9 echo rule; exercises host_error:approval_identity_mismatch)."
            },
            "echo_recomputed": {
              "type": "boolean",
              "description": "§9 redaction pinning: the scripted resolver recomputes the jcs-sha256 identity from the request context it actually received and echoes that, so a host that computed the request identity over a different (unredacted) context fails the echo rule. Overrides identity_override."
            }
          },
          "oneOf": [
            {
              "required": [
                "outcome"
              ]
            },
            {
              "required": [
                "fault"
              ]
            }
          ]
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interceptions",
        "run_outcome"
      ],
      "properties": {
        "interceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "interception_point"
            ],
            "properties": {
              "interception_point": {
                "$ref": "https://responsibleai.github.io/agent-hooks/schema/v0.1/interception-point.schema.json"
              },
              "context": {
                "type": "object",
                "additionalProperties": true,
                "description": "Dotted-path -> expected-value assertions against the recorded AgentContext."
              },
              "context_must_validate": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "sequence_strict": {
          "type": "boolean",
          "default": true
        },
        "interceptions_absent": {
          "type": "array",
          "items": {
            "$ref": "https://responsibleai.github.io/agent-hooks/schema/v0.1/interception-point.schema.json"
          }
        },
        "tool_invocations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "args"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "args": {
                "type": "object"
              }
            }
          }
        },
        "tool_not_invoked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "final_output": true,
        "run_outcome": {
          "type": "string",
          "enum": [
            "completed",
            "blocked",
            "error"
          ]
        },
        "identities_equal": {
          "type": "boolean",
          "description": "Assert input_identity == enforced_identity for all interception points (false to assert they differ at some interception point)."
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "interception_point"
            ],
            "properties": {
              "interception_point": {
                "$ref": "https://responsibleai.github.io/agent-hooks/schema/v0.1/interception-point.schema.json"
              },
              "assert": {
                "type": "object",
                "additionalProperties": true,
                "description": "Dotted-path -> expected-value assertions against the wire-shaped InterceptionRecord (§10.3): verdict.*, composition.*, verdicts[i].*, fold_truncated, resolved_by, identity_provider, input_identity/enforced_identity (null for the null provider)."
              },
              "absent": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Dotted paths that MUST NOT resolve on the matched record (e.g. verdict.transform.value under the §10.3 payload-free projection)."
              },
              "present": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Dotted paths that MUST resolve on the matched record without pinning the value (e.g. timestamp, whose value is host-dynamic)."
              }
            }
          },
          "description": "Forward-scan-ordered record assertions, matched by interception_point."
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "interceptor_script"
      ]
    },
    {
      "required": [
        "interceptor_scripts"
      ]
    }
  ]
}
