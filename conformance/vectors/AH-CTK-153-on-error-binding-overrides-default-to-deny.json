{
  "id": "AH-CTK-153",
  "title": "§7.7.5: a binding's on_error deny overrides a document default of continue: the raise denies, tool not invoked",
  "spec_clause": "6.3.1, 7.7.3, 7.7.5, 10.3",
  "part": "failure_posture/deny",
  "capabilities": [
    "host_declaration",
    "model_calls",
    "tool_calls"
  ],
  "host_declaration": {
    "declaration": "agent-hooks-declaration/1.1",
    "configuration": {
      "failure": {
        "on_error": "continue"
      }
    },
    "bindings": [
      {
        "id": "flaky",
        "kind": "ctk.scripted",
        "config": {
          "script": 0
        },
        "on_error": "deny"
      }
    ]
  },
  "scenario": {
    "input": {
      "content": "fetch",
      "role": "user"
    },
    "tools": [
      {
        "name": "http_get",
        "behavior": [
          {
            "return": "UNREACHED"
          }
        ]
      }
    ],
    "model_script": [
      {
        "respond": {
          "content": null,
          "tool_calls": [
            {
              "id": "tc-1",
              "name": "http_get",
              "args": {
                "url": "https://x"
              }
            }
          ],
          "finish_reason": "tool_calls"
        }
      },
      {
        "respond": {
          "content": "could not fetch",
          "tool_calls": [],
          "finish_reason": "stop"
        }
      }
    ]
  },
  "interceptor_scripts": [
    [
      {
        "at": "pre_tool_call",
        "fault": "raise"
      }
    ]
  ],
  "expect": {
    "load": {
      "outcome": "accepted"
    },
    "sequence_strict": false,
    "interceptions": [
      {
        "interception_point": "pre_tool_call"
      }
    ],
    "interceptions_absent": [
      "post_tool_call"
    ],
    "tool_not_invoked": [
      "http_get"
    ],
    "records": [
      {
        "interception_point": "pre_tool_call",
        "assert": {
          "declaration": "agent-hooks-declaration/1.1",
          "verdict.decision": "deny",
          "verdict.reason": "host_error:interceptor_failed",
          "decided_by": 0
        }
      }
    ],
    "run_outcome": "completed",
    "run_outcome_by_posture": {
      "posture": "tool_seam_host_error",
      "outcomes": {
        "continue": "completed",
        "terminate": "blocked"
      }
    }
  }
}
