{
  "id": "AH-CTK-122",
  "title": "§7.7: a declaration selecting evaluate_only validates a transform without applying it and stamps the mode and contract",
  "spec_clause": "7.7.3, 8, 10.3",
  "part": "declaration/load",
  "capabilities": [
    "host_declaration",
    "model_calls",
    "tool_calls"
  ],
  "host_declaration": {
    "declaration": "agent-hooks-declaration/1.0",
    "configuration": {
      "mode": "evaluate_only"
    },
    "bindings": [
      {
        "id": "rewrite",
        "kind": "ctk.scripted",
        "config": {
          "script": 0
        }
      }
    ]
  },
  "scenario": {
    "input": {
      "content": "fetch",
      "role": "user"
    },
    "tools": [
      {
        "name": "http_get",
        "behavior": [
          {
            "return": "ok"
          }
        ]
      }
    ],
    "model_script": [
      {
        "respond": {
          "content": null,
          "tool_calls": [
            {
              "id": "tc-1",
              "name": "http_get",
              "args": {
                "url": "https://x"
              }
            }
          ],
          "finish_reason": "tool_calls"
        }
      },
      {
        "respond": {
          "content": "done",
          "tool_calls": [],
          "finish_reason": "stop"
        }
      }
    ]
  },
  "interceptor_scripts": [
    [
      {
        "at": "pre_tool_call",
        "return": {
          "decision": "transform",
          "transform": {
            "path": "$target.url",
            "value": "https://safe"
          }
        }
      }
    ]
  ],
  "expect": {
    "load": {
      "outcome": "accepted"
    },
    "sequence_strict": false,
    "interceptions": [
      {
        "interception_point": "pre_tool_call"
      },
      {
        "interception_point": "post_tool_call",
        "context": {
          "tool_call.args.url": "https://x"
        }
      }
    ],
    "records": [
      {
        "interception_point": "pre_tool_call",
        "assert": {
          "declaration": "agent-hooks-declaration/1.0",
          "mode": "evaluate_only",
          "verdict.decision": "transform",
          "verdict.transform.path": "$target.url",
          "verdicts[0].name": "rewrite"
        },
        "absent": [
          "verdict.transform.value"
        ]
      }
    ],
    "tool_invocations": [
      {
        "name": "http_get",
        "args": {
          "url": "https://x"
        }
      }
    ],
    "run_outcome": "completed",
    "final_output": "done",
    "identities_equal": true
  }
}
