{
  "id": "AH-CTK-133",
  "title": "§7.7.3: a knob the declared profile does not consult is refused as inconsistent, not silently cleared",
  "spec_clause": "7.7.3, 7.2",
  "part": "declaration/refusal",
  "capabilities": [
    "host_declaration"
  ],
  "host_declaration": {
    "declaration": "agent-hooks-declaration/1.0",
    "configuration": {
      "composition": {
        "profile": "sequential/run_all",
        "on_approval": "resume"
      }
    },
    "bindings": [
      {
        "id": "allow",
        "kind": "ctk.scripted",
        "config": {
          "script": 0
        }
      }
    ]
  },
  "scenario": {
    "input": {
      "content": "hi",
      "role": "user"
    },
    "model_script": [
      {
        "respond": {
          "content": "UNREACHED",
          "tool_calls": [],
          "finish_reason": "stop"
        }
      }
    ]
  },
  "interceptor_scripts": [
    [
      {
        "at": "pre_tool_call",
        "return": {
          "decision": "allow"
        }
      }
    ]
  ],
  "expect": {
    "load": {
      "outcome": "refused",
      "class": "declaration_error:inconsistent"
    }
  }
}
