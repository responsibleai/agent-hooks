{
  "id": "AH-CTK-012",
  "title": "deny at output prevents response from being returned",
  "spec_clause": "6",
  "capabilities": [
    "model_calls"
  ],
  "scenario": {
    "input": {
      "content": "tell me a secret",
      "role": "user"
    },
    "model_script": [
      {
        "respond": {
          "content": "the secret is X",
          "tool_calls": [],
          "finish_reason": "stop"
        }
      }
    ]
  },
  "interceptor_script": [
    {
      "at": "output",
      "return": {
        "decision": "deny",
        "reason": "ctk:output_blocked"
      }
    }
  ],
  "expect": {
    "sequence_strict": true,
    "interceptions": [
      {
        "interception_point": "agent_startup"
      },
      {
        "interception_point": "input"
      },
      {
        "interception_point": "pre_model_call"
      },
      {
        "interception_point": "post_model_call"
      },
      {
        "interception_point": "output",
        "context": {
          "output.content": "the secret is X"
        }
      },
      {
        "interception_point": "agent_shutdown"
      }
    ],
    "final_output": null,
    "run_outcome": "blocked"
  }
}