<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ResponsibleAI.AgentHooks</PackageId>
    <Description>Native C# Agent Hooks SDK (draft spec): typed hooks over the generated contracts, composition, approval, declarations and interception records. Cooperative contract, not a security boundary: the host is fully trusted (see SECURITY.md).</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>AgentHooks</RootNamespace>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackContracts</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ship the generated contracts inside this package: it is the SDK's only nupkg. -->
    <ProjectReference Include="../AgentHooks.Contracts/AgentHooks.Contracts.csproj" PrivateAssets="all" />
    <PackageReference Include="JsonSchema.Net" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <EmbeddedResource Include="../../../../spec/draft/schema/generated/*.json"
                      LogicalName="AgentHooks.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="PackContracts">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutDir)AgentHooks.Contracts.dll" />
      <BuildOutputInPackage Include="$(OutDir)AgentHooks.Contracts.xml" />
    </ItemGroup>
  </Target>
</Project>
