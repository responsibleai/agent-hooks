<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ResponsibleAI.AgentHooks</PackageId>
    <Description>Native C# Agent Hooks SDK (draft spec): typed hooks over the generated contracts, composition, approval, declarations and interception records. Cooperative contract, not a security boundary: the host is fully trusted (see SECURITY.md).</Description>
    <RootNamespace>AgentHooks</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AgentHooks.Contracts/AgentHooks.Contracts.csproj" />
    <PackageReference Include="JsonSchema.Net" />
    <EmbeddedResource Include="../../../../spec/draft/schema/generated/*.json"
                      LogicalName="AgentHooks.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
