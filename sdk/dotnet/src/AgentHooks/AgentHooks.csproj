<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ResponsibleAI.AgentHooks</PackageId>
    <Description>Framework-neutral agent control contract (AGENT-HOOKS-0.1). .NET wrapper over the canonical Rust core via libagent_hooks_ffi. Cooperative contract, not a security boundary: the host is fully trusted (see SECURITY.md).</Description>
    <RootNamespace>AgentHooks</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Native library resolved at runtime via NativeLibrary search paths.
         Packaging: the current NuGet package does NOT bundle
         libagent_hooks_ffi; consumers make it resolvable per OS (see
         README "Native library deployment"). Per-RID bundling under
         runtimes/<rid>/native/ is planned. For local dev, set
         LD_LIBRARY_PATH / DYLD_LIBRARY_PATH / PATH to sdk/rust/target/release. -->
  </ItemGroup>
</Project>
