{
  "id": "AH-CTK-160",
  "title": "§7.7.4: a surface naming incremental_output without model_calls, and so without both model points, is refused as inconsistent; incremental mediation happens at post_model_call",
  "spec_clause": "7.7.4, 7.7.6, 12.1",
  "introduced_in": "draft",
  "part": "declaration/refusal",
  "capabilities": [
    "host_declaration"
  ],
  "host_declaration": {
    "declaration": "agent-hooks-declaration/1.1",
    "spec": "agent-hooks/draft",
    "surface": {
      "interception_points": [
        "agent_startup",
        "input",
        "output",
        "agent_shutdown"
      ],
      "capabilities": [
        "host_declaration",
        "incremental_output"
      ],
      "buffered_output": false,
      "exposure_bound": "one chunk"
    },
    "bindings": [
      {
        "id": "allow",
        "kind": "ctk.scripted",
        "config": {
          "script": 0
        }
      }
    ]
  },
  "scenario": {
    "input": {
      "content": "hi",
      "role": "user"
    },
    "model_script": [
      {
        "respond": {
          "content": "UNREACHED",
          "tool_calls": [],
          "finish_reason": "stop"
        }
      }
    ]
  },
  "interceptor_scripts": [
    [
      {
        "at": "pre_tool_call",
        "return": {
          "decision": "allow"
        }
      }
    ]
  ],
  "expect": {
    "load": {
      "outcome": "refused",
      "class": "declaration_error:inconsistent"
    }
  }
}
