{
  "id": "AH-CTK-124",
  "title": "§7.7.5: bindings run only at their points; interceptors_registered, verdicts[].index and decided_by count the list bound at the emitted point",
  "spec_clause": "7.7.5, 7.7.8, 10.3",
  "part": "declaration/bindings",
  "capabilities": [
    "host_declaration",
    "model_calls",
    "tool_calls"
  ],
  "host_declaration": {
    "declaration": "agent-hooks-declaration/1.0",
    "bindings": [
      {
        "id": "a",
        "kind": "ctk.scripted",
        "config": {
          "script": 0
        },
        "at": [
          "pre_tool_call"
        ]
      },
      {
        "id": "b",
        "kind": "ctk.scripted",
        "config": {
          "script": 1
        }
      }
    ]
  },
  "scenario": {
    "input": {
      "content": "fetch",
      "role": "user"
    },
    "tools": [
      {
        "name": "http_get",
        "behavior": [
          {
            "return": "ok"
          }
        ]
      }
    ],
    "model_script": [
      {
        "respond": {
          "content": null,
          "tool_calls": [
            {
              "id": "tc-1",
              "name": "http_get",
              "args": {
                "url": "https://x"
              }
            }
          ],
          "finish_reason": "tool_calls"
        }
      },
      {
        "respond": {
          "content": "done",
          "tool_calls": [],
          "finish_reason": "stop"
        }
      }
    ]
  },
  "interceptor_scripts": [
    [
      {
        "at": "pre_tool_call",
        "return": {
          "decision": "deny",
          "reason": "ctk:dangerous_tool"
        }
      }
    ],
    [
      {
        "at": "pre_tool_call",
        "return": {
          "decision": "allow"
        }
      }
    ]
  ],
  "expect": {
    "load": {
      "outcome": "accepted"
    },
    "sequence_strict": true,
    "interceptions": [
      {
        "interception_point": "pre_tool_call",
        "context": {
          "tool_call.name": "http_get"
        }
      }
    ],
    "interceptions_absent": [
      "agent_startup",
      "input",
      "pre_model_call",
      "post_model_call",
      "post_tool_call",
      "output",
      "agent_shutdown"
    ],
    "records": [
      {
        "interception_point": "input",
        "assert": {
          "interceptors_registered": 1,
          "verdicts[0].name": "b",
          "verdict.decision": "allow"
        }
      },
      {
        "interception_point": "pre_tool_call",
        "assert": {
          "interceptors_registered": 2,
          "decided_by": 0,
          "verdicts[0].name": "a",
          "verdict.decision": "deny",
          "verdict.reason": "ctk:dangerous_tool",
          "fold_truncated": true
        }
      }
    ],
    "tool_not_invoked": [
      "http_get"
    ],
    "run_outcome": "completed"
  }
}
