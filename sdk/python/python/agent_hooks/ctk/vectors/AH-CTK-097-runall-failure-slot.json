{
  "id": "AH-CTK-097",
  "title": "run_all: per-interceptor §6.3 substitution — a failing interceptor denies its slot, others compose normally (reserved-reason detail is SDK-pinned)",
  "spec_clause": "6.3, 7.4, 10.3",
  "part": "composition/sequential_run_all",
  "capabilities": [
    "model_calls",
    "tool_calls"
  ],
  "scenario": {
    "input": {
      "content": "send wire",
      "role": "user"
    },
    "tools": [
      {
        "name": "wire_transfer",
        "behavior": [
          {
            "return": "UNREACHED"
          }
        ]
      }
    ],
    "model_script": [
      {
        "respond": {
          "content": null,
          "tool_calls": [
            {
              "id": "tc-1",
              "name": "wire_transfer",
              "args": {
                "amount": 100
              }
            }
          ],
          "finish_reason": "tool_calls"
        }
      },
      {
        "respond": {
          "content": "sent",
          "tool_calls": [],
          "finish_reason": "stop"
        }
      }
    ]
  },
  "expect": {
    "sequence_strict": false,
    "interceptions": [
      {
        "interception_point": "pre_tool_call"
      }
    ],
    "interceptions_absent": [
      "post_tool_call"
    ],
    "tool_not_invoked": [
      "wire_transfer"
    ],
    "records": [
      {
        "interception_point": "pre_tool_call",
        "assert": {
          "verdict.decision": "deny",
          "decided_by": 0,
          "verdicts[0].decision": "deny",
          "verdicts[1].decision": "allow",
          "verdicts[1].reason": "ctk:second-ran"
        }
      }
    ],
    "run_outcome": "completed"
  },
  "composition": {
    "profile": "sequential/run_all"
  },
  "interceptor_scripts": [
    [
      {
        "at": "pre_tool_call",
        "fault": "raise"
      }
    ],
    [
      {
        "at": "pre_tool_call",
        "return": {
          "decision": "allow",
          "reason": "ctk:second-ran"
        }
      }
    ]
  ]
}
