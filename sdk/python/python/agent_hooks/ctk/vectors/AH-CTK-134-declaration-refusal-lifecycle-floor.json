{
  "id": "AH-CTK-134",
  "title": "§7.7.4: a surface that omits a §3.2 floor point is refused as inconsistent",
  "spec_clause": "7.7.4, 3.2",
  "part": "declaration/refusal",
  "capabilities": [
    "host_declaration"
  ],
  "host_declaration": {
    "declaration": "agent-hooks-declaration/1.0",
    "surface": {
      "interception_points": [
        "agent_startup",
        "input",
        "pre_model_call",
        "post_model_call",
        "pre_tool_call",
        "post_tool_call",
        "output"
      ],
      "capabilities": [
        "host_declaration",
        "model_calls",
        "tool_calls"
      ]
    },
    "bindings": [
      {
        "id": "allow",
        "kind": "ctk.scripted",
        "config": {
          "script": 0
        }
      }
    ]
  },
  "scenario": {
    "input": {
      "content": "hi",
      "role": "user"
    },
    "model_script": [
      {
        "respond": {
          "content": "UNREACHED",
          "tool_calls": [],
          "finish_reason": "stop"
        }
      }
    ]
  },
  "interceptor_scripts": [
    [
      {
        "at": "pre_tool_call",
        "return": {
          "decision": "allow"
        }
      }
    ]
  ],
  "expect": {
    "load": {
      "outcome": "refused",
      "class": "declaration_error:inconsistent"
    }
  }
}
