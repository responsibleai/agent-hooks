{
  "name": "agent-hooks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@typespec/compiler": "1.18.0",
    "@typespec/json-schema": "1.18.0",
    "ajv-cli": "5.0.0",
    "ajv-formats": "3.0.1",
    "rimraf": "6.1.4"
  },
  "scripts": {
    "build:emitters": "pnpm --filter \"./emitters/*\" run build",
    "clean:schema": "rimraf spec/draft/schema/generated",
    "generate": "pnpm run build:emitters && pnpm run clean:schema && tsp compile spec/draft",
    "check:schema:equivalence": "pnpm --dir spec/scripts run check:schema:equivalence"
  }
}
