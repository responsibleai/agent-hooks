{
  "name": "agent-hooks",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@agent-hooks/emitter-csharp": "workspace:*",
    "@typespec/compiler": "1.18.0",
    "@typespec/json-schema": "1.18.0",
    "ajv-cli": "5.0.0",
    "ajv-formats": "3.0.1"
  },
  "scripts": {
    "build:emitters": "pnpm --filter './emitters/*' run build",
    "generate": "pnpm run build:emitters && pnpm run generate:schema && tsp compile spec/draft",
    "generate:schema": "pnpm --dir spec/scripts run generate:schema",
    "check:schema": "pnpm --dir spec/scripts run check:schema",
    "check:schema:equivalence": "pnpm --dir spec/scripts run check:schema:equivalence"
  }
}
