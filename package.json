{
  "name": "agent-hooks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@typespec/compiler": "catalog:",
    "@typespec/json-schema": "catalog:",
    "ajv-cli": "catalog:",
    "ajv-formats": "catalog:",
    "tsx": "catalog:"
  },
  "scripts": {
    "build": "pnpm -r build",
    "generate": "pnpm --filter \"@agent-hooks/spec-draft...\" run build",
    "check-for-changed-files": "tsx scripts/check-for-changed-files.ts",
    "check:schema:equivalence": "pnpm --dir spec/scripts run check:schema:equivalence"
  }
}
