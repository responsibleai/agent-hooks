{
  "name": "agent-hooks",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "ajv-cli": "5.0.0",
    "ajv-formats": "3.0.1"
  },
  "scripts": {
    "generate:csharp": "pnpm --dir spec/scripts run generate:csharp",
    "check:csharp": "pnpm --dir spec/scripts run check:csharp",
    "generate:schema": "pnpm --dir spec/scripts run generate:schema",
    "check:schema": "pnpm --dir spec/scripts run check:schema",
    "check:schema:equivalence": "pnpm --dir spec/scripts run check:schema:equivalence"
  }
}
