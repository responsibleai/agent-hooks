{
  "name": "agent-hooks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@typespec/compiler": "1.18.0",
    "@typespec/json-schema": "1.18.0",
    "ajv-cli": "5.0.0",
    "ajv-formats": "3.0.1"
  },
  "scripts": {
    "generate": "pnpm --filter \"@agent-hooks/spec-draft...\" run build",
    "check:changes": "git add --intent-to-add --ignore-removal :/ && git diff --exit-code",
    "check:schema:equivalence": "pnpm --dir spec/scripts run check:schema:equivalence"
  }
}
