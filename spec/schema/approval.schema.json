{
  "$id": "https://agent-hooks.responsibleai.dev/v0.1/approval.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks — approval seam",
  "description": "Approval request and resolution shapes for lifting a liftable deny (AGENT-HOOKS-0.1 §9). context_identity is an opaque provider-produced string, or null when identity_provider is null (§10.1); the only normative constraint is the echo rule.",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_identity",
        "interception_point",
        "verdict"
      ],
      "properties": {
        "context_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "interception_point": {
          "$ref": "interception-point.schema.json"
        },
        "verdict": {
          "description": "The liftable deny being consulted: an interceptor's (passes §5, verdict.schema.json) or the host-synthesized §7.5 shape, whose reason is a reserved host_error:* string that §5 forbids interceptors to emit — so this member is validated against the §5 schema only when its reason is not host_error:*.",
          "type": "object",
          "required": [
            "decision"
          ],
          "properties": {
            "decision": {
              "const": "deny"
            }
          }
        },
        "context": {
          "description": "The AgentContext as presented to the resolver. MAY be redacted per host policy.",
          "$ref": "agent-context.schema.json"
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "context_identity"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "approve",
            "reject",
            "unresolved"
          ]
        },
        "context_identity": {
          "type": [
            "string",
            "null"
          ],
          "description": "MUST equal the request's context_identity byte for byte (echo rule, §9); null echoes as null."
        },
        "verdict": {
          "$ref": "verdict.schema.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "unresolved"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "verdict"
              ]
            }
          },
          "else": {
            "required": [
              "verdict"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "approve"
              }
            }
          },
          "then": {
            "properties": {
              "verdict": {
                "properties": {
                  "decision": {
                    "enum": [
                      "allow",
                      "transform"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "reject"
              }
            }
          },
          "then": {
            "properties": {
              "verdict": {
                "properties": {
                  "decision": {
                    "const": "deny"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
