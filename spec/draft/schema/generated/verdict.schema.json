{
  "$id": "https://responsibleai.github.io/agent-hooks/schema/v0.1/verdict.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks — verdict",
  "description": "A verdict whose transform payload is valid for at least one hook.",
  "anyOf": [
    {
      "$ref": "#/$defs/AllowVerdict"
    },
    {
      "$ref": "#/$defs/DenyVerdict"
    },
    {
      "$ref": "#/$defs/TransformVerdict%3CInputHookTransform%7CPreModelHookTransform%7CPostModelHookTransform%7CPreToolHookTransform%7CPostToolHookTransform%7COutputHookTransform%3E"
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "AllowVerdict": {
      "description": "allow: proceed. Absorbs warn through warnings[] (§5.1).",
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "const": "allow"
        },
        "reason": {
          "description": "Interceptor-supplied machine identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11).",
          "pattern": "^(?!host_error:).*",
          "type": [
            "null",
            "string"
          ]
        },
        "message": {
          "description": "Human-readable text for the caller.",
          "type": [
            "null",
            "string"
          ]
        },
        "warnings": {
          "description": "Recorded concerns that do not affect control flow (§5.1). Permitted on any\ndecision; unioned across an emission's verdicts (§7.3). Reasons starting with\nhost_warning: are reserved for the host (§11.1).",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "description": "Offline-verifiable evidence attached to a verdict (§14).",
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "description": "Interceptor-supplied labels the host MUST persist with the produced data and\nresurface on later interception points (§5.4).",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "decision"
      ],
      "additionalProperties": false
    },
    "Warning": {
      "description": "A recorded concern that does not affect control flow (§5.1).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "reason": {
          "description": "Interceptor-supplied warning identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11) and host_warning: for host-synthesized\nwarnings (§11.1); an interceptor warning with either prefix fails §5\nvalidation.",
          "pattern": "^(?!host_error:|host_warning:).*",
          "type": [
            "null",
            "string"
          ]
        },
        "message": {
          "type": [
            "null",
            "string"
          ]
        }
      }
    },
    "Evidence": {
      "description": "Offline-verifiable evidence attached to a verdict (§14).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "artefact": {
          "description": "Content address (sha256:<hex>) or URI of an offline-verifiable proof.",
          "type": [
            "null",
            "string"
          ]
        },
        "verification_pointers": {
          "description": "Named URIs an auditor MAY consult. Hosts MUST NOT dereference automatically (§14).",
          "$ref": "#/$defs/VerificationPointers"
        }
      }
    },
    "VerificationPointers": {
      "description": "Named URIs an auditor MAY consult. Hosts MUST NOT dereference automatically (§14).",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "DenyVerdict": {
      "description": "deny: stop the action. Absorbs escalate through the approval block (§5.1).",
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "const": "deny"
        },
        "approval": {
          "description": "Present only on deny: marks the deny as liftable by the approval seam (§9).\nMAY be empty; reserved for approver-facing parameters.",
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "reason": {
          "description": "Interceptor-supplied machine identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11).",
          "pattern": "^(?!host_error:).*",
          "type": [
            "null",
            "string"
          ]
        },
        "message": {
          "description": "Human-readable text for the caller.",
          "type": [
            "null",
            "string"
          ]
        },
        "warnings": {
          "description": "Recorded concerns that do not affect control flow (§5.1). Permitted on any\ndecision; unioned across an emission's verdicts (§7.3). Reasons starting with\nhost_warning: are reserved for the host (§11.1).",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "description": "Offline-verifiable evidence attached to a verdict (§14).",
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "description": "Interceptor-supplied labels the host MUST persist with the produced data and\nresurface on later interception points (§5.4).",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "decision"
      ],
      "additionalProperties": false
    },
    "TransformVerdict<InputHookTransform|PreModelHookTransform|PostModelHookTransform|PreToolHookTransform|PostToolHookTransform|OutputHookTransform>": {
      "description": "transform: proceed with the hook-specific replacement payload.",
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "const": "transform"
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputHookTransform"
            },
            {
              "$ref": "#/$defs/PreModelHookTransform"
            },
            {
              "$ref": "#/$defs/PostModelHookTransform"
            },
            {
              "$ref": "#/$defs/PreToolHookTransform"
            },
            {
              "$ref": "#/$defs/PostToolHookTransform"
            },
            {
              "$ref": "#/$defs/OutputHookTransform"
            }
          ]
        },
        "reason": {
          "description": "Interceptor-supplied machine identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11).",
          "pattern": "^(?!host_error:).*",
          "type": [
            "null",
            "string"
          ]
        },
        "message": {
          "description": "Human-readable text for the caller.",
          "type": [
            "null",
            "string"
          ]
        },
        "warnings": {
          "description": "Recorded concerns that do not affect control flow (§5.1). Permitted on any\ndecision; unioned across an emission's verdicts (§7.3). Reasons starting with\nhost_warning: are reserved for the host (§11.1).",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "description": "Offline-verifiable evidence attached to a verdict (§14).",
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "description": "Interceptor-supplied labels the host MUST persist with the produced data and\nresurface on later interception points (§5.4).",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "decision",
        "transform"
      ]
    },
    "InputHookTransform": {
      "description": "Replaces the complete input payload.",
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/Input"
        }
      },
      "required": [
        "input"
      ]
    },
    "Input": {
      "description": "Conditional payload of input (§4.2).",
      "type": "object",
      "properties": {
        "content": {},
        "role": {
          "$ref": "#/$defs/InputRole"
        }
      },
      "required": [
        "content",
        "role"
      ]
    },
    "InputRole": {
      "description": "Who produced an input (§4.2).",
      "type": "string",
      "enum": [
        "user",
        "system",
        "external"
      ]
    },
    "PreModelHookTransform": {
      "description": "Replaces the complete model-message array.",
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          }
        }
      },
      "required": [
        "messages"
      ]
    },
    "Message": {
      "description": "One message of the model request (§4.2).",
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "content": {}
      },
      "required": [
        "content",
        "role"
      ]
    },
    "PostModelHookTransform": {
      "description": "Replaces the complete model response payload.",
      "type": "object",
      "properties": {
        "response": {
          "$ref": "#/$defs/Response"
        }
      },
      "required": [
        "response"
      ]
    },
    "Response": {
      "description": "Conditional payload of post_model_call (§4.2).",
      "type": "object",
      "properties": {
        "content": {},
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolCallRequest"
          }
        },
        "finish_reason": {
          "type": "string"
        }
      },
      "required": [
        "content",
        "finish_reason",
        "tool_calls"
      ]
    },
    "ToolCallRequest": {
      "description": "One tool call the model asked for (§4.2).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        }
      },
      "required": [
        "args",
        "name"
      ]
    },
    "PreToolHookTransform": {
      "description": "Replaces the complete tool args for the pre-tool hook.",
      "type": "object",
      "properties": {
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        }
      },
      "required": [
        "args"
      ]
    },
    "PostToolHookTransform": {
      "description": "Replaces only the value of the tool result.",
      "type": "object",
      "properties": {
        "value": {}
      },
      "required": [
        "value"
      ]
    },
    "OutputHookTransform": {
      "description": "Replaces the complete output payload.",
      "type": "object",
      "properties": {
        "output": {
          "$ref": "#/$defs/Output"
        }
      },
      "required": [
        "output"
      ]
    },
    "Output": {
      "description": "Conditional payload of output (§4.2).",
      "type": "object",
      "properties": {
        "content": {}
      },
      "required": [
        "content"
      ]
    }
  }
}
