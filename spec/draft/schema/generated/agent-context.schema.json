{
  "$id": "https://responsibleai.github.io/agent-hooks/schema/v0.1/agent-context.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks — agent context",
  "description": "Payload a host constructs at each interception point (AGENT-HOOKS-0.1 §4).\nEach variant has only shared required metadata, its discriminator, its\nrequired hook payload, and the optional namespaced extensions object.",
  "anyOf": [
    {
      "$ref": "#/$defs/AgentStartupContext"
    },
    {
      "$ref": "#/$defs/InputContext"
    },
    {
      "$ref": "#/$defs/PreModelCallContext"
    },
    {
      "$ref": "#/$defs/PostModelCallContext"
    },
    {
      "$ref": "#/$defs/PreToolCallContext"
    },
    {
      "$ref": "#/$defs/PostToolCallContext"
    },
    {
      "$ref": "#/$defs/OutputContext"
    },
    {
      "$ref": "#/$defs/AgentShutdownContext"
    }
  ],
  "$defs": {
    "AgentStartupContext": {
      "description": "The context at agent_startup: agent_init is required (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "interception_point": {
          "type": "string",
          "const": "agent_startup"
        },
        "agent_init": {
          "$ref": "#/$defs/AgentInit"
        },
        "spec": {
          "pattern": "^agent-hooks/\\d+\\.\\d+$",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "agent": {
          "$ref": "#/$defs/AgentMetadata"
        },
        "session": {
          "$ref": "#/$defs/SessionMetadata"
        },
        "extensions": {
          "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "agent",
        "agent_init",
        "interception_point",
        "sequence",
        "session",
        "spec",
        "timestamp"
      ]
    },
    "AgentInit": {
      "description": "Conditional payload of agent_startup (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "tools_registered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "tools_registered"
      ]
    },
    "AgentMetadata": {
      "description": "Shared metadata present at every interception point.",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "framework": {
          "pattern": "^[a-z0-9_-]+$",
          "type": "string"
        }
      },
      "required": [
        "framework",
        "id"
      ]
    },
    "SessionMetadata": {
      "description": "Shared session identity present at every interception point.",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "Extensions": {
      "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "type": "object",
      "additionalProperties": {}
    },
    "InputContext": {
      "description": "The context at input: input is required (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "interception_point": {
          "type": "string",
          "const": "input"
        },
        "input": {
          "$ref": "#/$defs/Input"
        },
        "spec": {
          "pattern": "^agent-hooks/\\d+\\.\\d+$",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "agent": {
          "$ref": "#/$defs/AgentMetadata"
        },
        "session": {
          "$ref": "#/$defs/SessionMetadata"
        },
        "extensions": {
          "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "agent",
        "input",
        "interception_point",
        "sequence",
        "session",
        "spec",
        "timestamp"
      ]
    },
    "Input": {
      "description": "Conditional payload of input (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/JsonValue"
        },
        "role": {
          "$ref": "#/$defs/InputRole"
        }
      },
      "required": [
        "content",
        "role"
      ]
    },
    "JsonValue": {
      "description": "JSON data carried by hook payloads.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "$ref": "#/$defs/JsonObject"
        },
        {
          "type": [
            "null",
            "string",
            "number",
            "boolean"
          ]
        }
      ]
    },
    "JsonObject": {
      "description": "A JSON object with arbitrary JSON-valued members.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "InputRole": {
      "description": "Who produced an input (§4.2).",
      "type": "string",
      "enum": [
        "user",
        "system",
        "external"
      ]
    },
    "PreModelCallContext": {
      "description": "The context at pre_model_call: model and messages are required (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "interception_point": {
          "type": "string",
          "const": "pre_model_call"
        },
        "model": {
          "$ref": "#/$defs/Model"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          }
        },
        "spec": {
          "pattern": "^agent-hooks/\\d+\\.\\d+$",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "agent": {
          "$ref": "#/$defs/AgentMetadata"
        },
        "session": {
          "$ref": "#/$defs/SessionMetadata"
        },
        "extensions": {
          "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "agent",
        "interception_point",
        "messages",
        "model",
        "sequence",
        "session",
        "spec",
        "timestamp"
      ]
    },
    "Model": {
      "description": "Conditional payload of pre_model_call and post_model_call (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "Message": {
      "description": "One message of the model request (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "content",
        "role"
      ]
    },
    "PostModelCallContext": {
      "description": "The context at post_model_call: model and response are required (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "interception_point": {
          "type": "string",
          "const": "post_model_call"
        },
        "model": {
          "$ref": "#/$defs/Model"
        },
        "response": {
          "$ref": "#/$defs/Response"
        },
        "spec": {
          "pattern": "^agent-hooks/\\d+\\.\\d+$",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "agent": {
          "$ref": "#/$defs/AgentMetadata"
        },
        "session": {
          "$ref": "#/$defs/SessionMetadata"
        },
        "extensions": {
          "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "agent",
        "interception_point",
        "model",
        "response",
        "sequence",
        "session",
        "spec",
        "timestamp"
      ]
    },
    "Response": {
      "description": "Conditional payload of post_model_call (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/JsonValue"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolCallRequest"
          }
        },
        "finish_reason": {
          "type": "string"
        }
      },
      "required": [
        "content",
        "finish_reason",
        "tool_calls"
      ]
    },
    "ToolCallRequest": {
      "description": "One tool call the model asked for (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "args": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "args",
        "name"
      ]
    },
    "PreToolCallContext": {
      "description": "The context at pre_tool_call: tool_call is required (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "interception_point": {
          "type": "string",
          "const": "pre_tool_call"
        },
        "tool_call": {
          "$ref": "#/$defs/ToolCall"
        },
        "spec": {
          "pattern": "^agent-hooks/\\d+\\.\\d+$",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "agent": {
          "$ref": "#/$defs/AgentMetadata"
        },
        "session": {
          "$ref": "#/$defs/SessionMetadata"
        },
        "extensions": {
          "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "agent",
        "interception_point",
        "sequence",
        "session",
        "spec",
        "timestamp",
        "tool_call"
      ]
    },
    "ToolCall": {
      "description": "Conditional payload of pre_tool_call and post_tool_call (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "args": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "args",
        "id",
        "name"
      ]
    },
    "PostToolCallContext": {
      "description": "The context at post_tool_call: tool_call and tool_result are required (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "interception_point": {
          "type": "string",
          "const": "post_tool_call"
        },
        "tool_call": {
          "$ref": "#/$defs/ToolCall"
        },
        "tool_result": {
          "$ref": "#/$defs/ToolResult"
        },
        "spec": {
          "pattern": "^agent-hooks/\\d+\\.\\d+$",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "agent": {
          "$ref": "#/$defs/AgentMetadata"
        },
        "session": {
          "$ref": "#/$defs/SessionMetadata"
        },
        "extensions": {
          "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "agent",
        "interception_point",
        "sequence",
        "session",
        "spec",
        "timestamp",
        "tool_call",
        "tool_result"
      ]
    },
    "ToolResult": {
      "description": "Conditional payload of post_tool_call (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "is_error": {
          "type": "boolean"
        }
      },
      "required": [
        "is_error",
        "value"
      ]
    },
    "OutputContext": {
      "description": "The context at output: output is required (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "interception_point": {
          "type": "string",
          "const": "output"
        },
        "output": {
          "$ref": "#/$defs/Output"
        },
        "spec": {
          "pattern": "^agent-hooks/\\d+\\.\\d+$",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "agent": {
          "$ref": "#/$defs/AgentMetadata"
        },
        "session": {
          "$ref": "#/$defs/SessionMetadata"
        },
        "extensions": {
          "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "agent",
        "interception_point",
        "output",
        "sequence",
        "session",
        "spec",
        "timestamp"
      ]
    },
    "Output": {
      "description": "Conditional payload of output (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "content"
      ]
    },
    "AgentShutdownContext": {
      "description": "The context at agent_shutdown: summary is required (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "interception_point": {
          "type": "string",
          "const": "agent_shutdown"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "spec": {
          "pattern": "^agent-hooks/\\d+\\.\\d+$",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "agent": {
          "$ref": "#/$defs/AgentMetadata"
        },
        "session": {
          "$ref": "#/$defs/SessionMetadata"
        },
        "extensions": {
          "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "agent",
        "interception_point",
        "sequence",
        "session",
        "spec",
        "summary",
        "timestamp"
      ]
    },
    "Summary": {
      "description": "Conditional payload of agent_shutdown (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/$defs/SummaryReason"
        }
      },
      "required": [
        "reason"
      ]
    },
    "SummaryReason": {
      "description": "Why the agent stopped (§4.2).",
      "type": "string",
      "enum": [
        "completed",
        "error",
        "cancelled"
      ]
    }
  }
}
