        "agent": {
          "type": "object",
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "framework": {
              "pattern": "^[a-z0-9_-]+$",
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "framework",
            "id"
          ]
        },
        "session": {
          "type": "object",
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "started_at": {
              "format": "date-time",
              "type": "string"
            },
            "turn": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "id"
          ]
        },
        "target": {},
        "agent_init": {
          "description": "Conditional payload of agent_startup (§4.2).",
          "$ref": "#/$defs/AgentInit"
        },
        "model": {
          "description": "Conditional payload of pre_model_call and post_model_call (§4.2).",
          "$ref": "#/$defs/Model"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          }
        },
        "request_id": {
          "type": "string"
        },
        "response": {
          "description": "Conditional payload of post_model_call (§4.2).",
          "$ref": "#/$defs/Response"
        },
        "usage": {
          "description": "Token usage of a model call (§4.3).",
          "$ref": "#/$defs/Usage"
        },
        "tool_call": {
          "description": "Conditional payload of pre_tool_call and post_tool_call (§4.2).",
          "$ref": "#/$defs/ToolCall"
        },
        "tool_result": {
          "description": "Conditional payload of post_tool_call (§4.2).",
          "$ref": "#/$defs/ToolResult"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolDecl"
          }
        },
        "output": {
          "description": "Conditional payload of output (§4.2).",
          "$ref": "#/$defs/Output"
        },
        "summary": {
          "description": "Conditional payload of agent_shutdown (§4.2).",
          "$ref": "#/$defs/Summary"
        },
        "trace": {
          "type": "object",
          "properties": {
            "trace_id": {
              "type": "string"
            },
            "span_id": {
              "type": "string"
            }
          }
        },
        "tenant": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "actor": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "description": "Who acts (§4.5).",
              "enum": [
                "agent",
                "human",
                "service"
              ],
              "type": "string"
            }
          }
        },
        "budgets": {
          "type": "object",
          "properties": {
            "tool_call_count": {
              "type": "number"
            },
            "token_count": {
              "type": "number"
            },
            "elapsed_seconds": {
              "type": "number"
            },
            "cost_usd": {
              "type": "number"
            }
          }
        },
        "extensions": {
          "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "agent",
        "input",
        "interception_point",
        "sequence",
        "session",
        "spec",
        "target",
        "timestamp"
      ]
    },
