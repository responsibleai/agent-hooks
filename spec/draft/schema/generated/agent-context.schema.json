              "type": "number"
            },
            "elapsed_seconds": {
              "type": "number"
            },
            "cost_usd": {
              "type": "number"
            }
          }
        },
        "interception_point": {
          "type": "string",
          "const": "agent_shutdown"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        }
      },
      "required": [
        "spec",
        "timestamp",
        "sequence",
        "agent",
        "session",
        "interception_point",
        "summary"
      ],
      "description": "The request at agent_shutdown: summary is required (§4.2)."
    },
    "ActorKind": {
      "type": "string",
      "enum": [
        "human",
        "service",
        "agent"
      ],
      "description": "Who acts (§4.5)."
    },
    "Extensions": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {},
      "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "AgentInit": {
      "type": "object",
      "properties": {
        "tools_registered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "tools_registered"
      ],
      "description": "Conditional payload of agent_startup (§4.2)."
    },
    "Input": {
      "type": "object",
      "properties": {
        "content": {},
        "role": {
          "$ref": "#/$defs/InputRole"
        }
      },
      "required": [
        "content",
        "role"
      ],
      "description": "Conditional payload of input (§4.2)."
    },
    "Model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "id"
      ],
      "description": "Conditional payload of pre_model_call and post_model_call (§4.2)."
    },
    "Message": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "content": {}
      },
      "required": [
        "role",
        "content"
      ],
      "description": "One message of the model request (§4.2)."
    },
    "ToolDecl": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "schema": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "name"
      ],
      "description": "One declared tool (§4.3)."
    },
    "Response": {
      "type": "object",
      "properties": {
        "content": {},
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolCallRequest"
          }
        },
        "finish_reason": {
          "type": "string"
        }
      },
      "required": [
        "content",
        "tool_calls",
        "finish_reason"
      ],
      "description": "Conditional payload of post_model_call (§4.2)."
    },
    "Usage": {
      "type": "object",
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Token usage of a model call (§4.3)."
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "$ref": "#/$defs/JsonObject"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "name",
        "args"
      ],
      "description": "Conditional payload of pre_tool_call and post_tool_call (§4.2)."
    },
    "ToolResult": {
      "type": "object",
      "properties": {
        "value": {},
        "is_error": {
          "type": "boolean"
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "value",
        "is_error"
      ],
      "description": "Conditional payload of post_tool_call (§4.2)."
    },
    "Output": {
      "type": "object",
      "properties": {
        "content": {}
      },
      "required": [
        "content"
      ],
      "description": "Conditional payload of output (§4.2)."
    },
    "Summary": {
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/$defs/SummaryReason"
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "reason"
      ],
      "description": "Conditional payload of agent_shutdown (§4.2)."
    },
    "InputRole": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "external"
      ],
      "description": "Who produced an input (§4.2)."
    },
    "JsonObject": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {},
      "description": "An open JSON object, not an arbitrary JSON value."
    },
    "ToolCallRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "args": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "name",
        "args"
      ],
      "description": "One tool call the model asked for (§4.2)."
    },
    "SummaryReason": {
      "type": "string",
      "enum": [
        "completed",
        "error",
        "cancelled"
      ],
      "description": "Why the agent stopped (§4.2)."
    }
  }
}
