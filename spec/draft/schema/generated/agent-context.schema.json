        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "agent": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "framework": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "framework"
          ]
        },
        "session": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "turn": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "id"
          ]
        },
        "trace": {
          "type": "object",
          "properties": {
            "trace_id": {
              "type": "string"
            },
            "span_id": {
              "type": "string"
            }
          }
        },
        "tenant": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
