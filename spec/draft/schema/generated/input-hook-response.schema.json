{
  "$id": "https://responsibleai.github.io/agent-hooks/schema/draft/input-hook-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks — input response",
  "description": "input response.",
  "type": "object",
  "properties": {
    "verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/AllowVerdict"
        },
        {
          "$ref": "#/$defs/DenyVerdict"
        },
        {
          "$ref": "#/$defs/TransformVerdictInputHookTransform"
        }
      ]
    },
    "extensions": {
      "$ref": "#/$defs/Extensions"
    }
  },
  "required": [
    "verdict"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "$defs": {
    "AllowVerdict": {
      "type": "object",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(?!host_error:).*",
          "description": "Interceptor-supplied machine identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11)."
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable text for the caller."
        },
        "warnings": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Recorded concerns that do not affect control flow (§5.1). Permitted on any\ndecision; unioned across an emission's verdicts (§7.3). Reasons starting with\nhost_warning: are reserved for the host (§11.1)."
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Interceptor-supplied labels the host MUST persist with the produced data and\nresurface on later interception points (§5.4)."
        },
        "decision": {
          "type": "string",
          "const": "allow"
        }
      },
      "required": [
        "decision"
      ],
      "unevaluatedProperties": {
        "not": {}
      },
      "description": "allow: proceed. Absorbs warn through warnings[] (§5.1)."
    },
    "DenyVerdict": {
      "type": "object",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(?!host_error:).*",
          "description": "Interceptor-supplied machine identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11)."
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable text for the caller."
        },
        "warnings": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Recorded concerns that do not affect control flow (§5.1). Permitted on any\ndecision; unioned across an emission's verdicts (§7.3). Reasons starting with\nhost_warning: are reserved for the host (§11.1)."
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Interceptor-supplied labels the host MUST persist with the produced data and\nresurface on later interception points (§5.4)."
        },
        "decision": {
          "type": "string",
          "const": "deny"
        },
        "approval": {
          "$ref": "#/$defs/JsonObject",
          "description": "Present only on deny: marks the deny as liftable by the approval seam (§9).\nMAY be empty; reserved for approver-facing parameters."
        }
      },
      "required": [
        "decision"
      ],
      "unevaluatedProperties": {
        "not": {}
      },
      "description": "deny: stop the action. Absorbs escalate through the approval block (§5.1)."
    },
    "TransformVerdictInputHookTransform": {
      "type": "object",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(?!host_error:).*",
          "description": "Interceptor-supplied machine identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11)."
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable text for the caller."
        },
        "warnings": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Recorded concerns that do not affect control flow (§5.1). Permitted on any\ndecision; unioned across an emission's verdicts (§7.3). Reasons starting with\nhost_warning: are reserved for the host (§11.1)."
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Interceptor-supplied labels the host MUST persist with the produced data and\nresurface on later interception points (§5.4)."
        },
        "decision": {
          "type": "string",
          "const": "transform"
        },
        "transform": {
          "$ref": "#/$defs/InputHookTransform"
        }
      },
      "required": [
        "decision",
        "transform"
      ],
      "unevaluatedProperties": {
        "not": {}
      },
      "description": "transform: proceed with the hook-specific replacement payload."
    },
    "Extensions": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {},
      "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "Warning": {
      "type": "object",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(?!host_error:|host_warning:).*",
          "description": "Interceptor-supplied warning identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11) and host_warning: for host-synthesized\nwarnings (§11.1); an interceptor warning with either prefix fails §5\nvalidation."
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "unevaluatedProperties": {
        "not": {}
      },
      "description": "A recorded concern that does not affect control flow (§5.1)."
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "artefact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Content address (sha256:<hex>) or URI of an offline-verifiable proof."
        },
        "verification_pointers": {
          "$ref": "#/$defs/VerificationPointers"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      },
      "description": "Offline-verifiable evidence attached to a verdict (§14)."
    },
    "JsonObject": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {},
      "description": "An open JSON object, not an arbitrary JSON value."
    },
    "InputHookTransform": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/Input"
        }
      },
      "required": [
        "input"
      ],
      "unevaluatedProperties": {
        "not": {}
      },
      "description": "Replaces the complete input payload."
    },
    "VerificationPointers": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {
        "type": "string"
      },
      "description": "Named URIs an auditor MAY consult. Hosts MUST NOT dereference automatically (§14)."
    },
    "Input": {
      "type": "object",
      "properties": {
        "content": {},
        "role": {
          "$ref": "#/$defs/InputRole"
        }
      },
      "required": [
        "content",
        "role"
      ],
      "description": "Conditional payload of input (§4.2)."
    },
    "InputRole": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "external"
      ],
      "description": "Who produced an input (§4.2)."
    }
  }
}
