{
  "$id": "https://responsibleai.github.io/agent-hooks/schema/draft/input-hook-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks — input response",
  "description": "Input responses.\n[allow](../examples/InputHookResponse/allow.json)\n[deny](../examples/InputHookResponse/deny.json)\n[transform](../examples/InputHookResponse/transform.json)\n[extensions](../examples/InputHookResponse/deny-with-extensions.json)",
  "type": "object",
  "properties": {
    "verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/AllowVerdict"
        },
        {
          "$ref": "#/$defs/DenyVerdict"
        },
        {
          "$ref": "#/$defs/TransformVerdictInputHookTransform"
        }
      ]
    },
    "extensions": {
      "$ref": "#/$defs/Extensions"
    }
  },
  "required": [
    "verdict"
  ],
  "additionalProperties": false,
  "$defs": {
    "AllowVerdict": {
      "type": "object",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(?!host_error:).*"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Labels the host persists with produced data and resurfaces at later hooks."
        },
        "decision": {
          "type": "string",
          "const": "allow"
        }
      },
      "required": [
        "decision"
      ],
      "description": "Proceed; warnings do not affect control flow.\n[allow](../examples/Verdict/allow.json)\n[with warning](../examples/Verdict/allow-with-warning.json)\n[with evidence](../examples/Verdict/allow-with-evidence.json)",
      "additionalProperties": false
    },
    "Warning": {
      "type": "object",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(?!host_error:|host_warning:).*",
          "description": "Host error and warning namespaces are reserved for the host."
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "A recorded concern that does not affect control flow (section 5.1).",
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "artefact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification_pointers": {
          "$ref": "#/$defs/VerificationPointers"
        }
      },
      "description": "Offline-verifiable evidence attached to a verdict (section 14).",
      "additionalProperties": false
    },
    "VerificationPointers": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {
        "type": "string"
      },
      "description": "Named URIs an auditor may consult; hosts must not dereference automatically."
    },
    "DenyVerdict": {
      "type": "object",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(?!host_error:).*"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Labels the host persists with produced data and resurfaces at later hooks."
        },
        "decision": {
          "type": "string",
          "const": "deny"
        },
        "approval": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "decision"
      ],
      "description": "Stop the action; an approval block makes the deny liftable.\n[deny](../examples/Verdict/deny.json)\n[with approval](../examples/Verdict/deny-with-approval.json)",
      "additionalProperties": false
    },
    "JsonObject": {
      "type": "object",
      "properties": {},
      "description": "An open JSON object, not an arbitrary JSON value."
    },
    "TransformVerdictInputHookTransform": {
      "type": "object",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(?!host_error:).*"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Labels the host persists with produced data and resurfaces at later hooks."
        },
        "decision": {
          "type": "string",
          "const": "transform"
        },
        "transform": {
          "$ref": "#/$defs/InputHookTransform"
        }
      },
      "required": [
        "decision",
        "transform"
      ],
      "description": "Proceed with the hook-specific replacement payload.\n[input](../examples/Verdict/transform-input.json)\n[messages](../examples/Verdict/transform-messages.json)\n[output](../examples/Verdict/transform-output.json)\n[response](../examples/Verdict/transform-response.json)\n[args](../examples/Verdict/transform-tool-args.json)\n[value](../examples/Verdict/transform-tool-result.json)",
      "additionalProperties": false
    },
    "InputHookTransform": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/Input"
        }
      },
      "required": [
        "input"
      ],
      "description": "Replaces the complete input payload.",
      "additionalProperties": false
    },
    "Input": {
      "type": "object",
      "properties": {
        "content": {},
        "role": {
          "$ref": "#/$defs/InputRole"
        }
      },
      "required": [
        "content",
        "role"
      ]
    },
    "InputRole": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "external"
      ],
      "description": "Who produced an input."
    },
    "Extensions": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {},
      "description": "Namespaced extensions (section 4.6); values are unconstrained JSON.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  }
}
