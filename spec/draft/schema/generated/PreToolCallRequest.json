{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://responsibleai.github.io/agent-hooks/schema/draft/PreToolCallRequest.json",
    "type": "object",
    "properties": {
        "spec": {
            "type": "string",
            "const": "agent-hooks/draft",
            "description": "This version's wire string (§4.1). A released version's contexts\ncarry that version's own string, agent-hooks/<major>.<minor>."
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "sequence": {
            "type": "integer",
            "minimum": 0
        },
        "agent": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "framework": {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]+$"
                },
                "name": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "framework"
            ]
        },
        "session": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "started_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "turn": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "required": [
                "id"
            ]
        },
        "trace": {
            "type": "object",
            "properties": {
                "trace_id": {
                    "type": "string"
                },
                "span_id": {
                    "type": "string"
                }
            }
        },
        "tenant": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "actor": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "kind": {
                    "$ref": "#/$defs/ActorKind"
                }
            }
        },
        "budgets": {
            "type": "object",
            "properties": {
                "tool_call_count": {
                    "type": "number"
                },
                "token_count": {
                    "type": "number"
                },
                "elapsed_seconds": {
                    "type": "number"
                },
                "cost_usd": {
                    "type": "number"
                }
            }
        },
        "interception_point": {
            "type": "string",
            "const": "pre_tool_call"
        },
        "extensions": {
            "$ref": "#/$defs/Extensions"
        },
        "tool_call": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "args": {
                    "$ref": "#/$defs/JsonObject"
                },
                "content_hash": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                }
            },
            "required": [
                "id",
                "name",
                "args"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        }
    },
    "required": [
        "spec",
        "timestamp",
        "sequence",
        "agent",
        "session",
        "interception_point",
        "tool_call"
    ],
    "description": "Candidate request at pre_tool_call, with a closed required payload.",
    "title": "Agent Hooks pre_tool_call request",
    "$defs": {
        "ActorKind": {
            "type": "string",
            "enum": [
                "human",
                "service",
                "agent"
            ],
            "description": "Who acts (§4.5)."
        },
        "Extensions": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {},
            "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
            "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]*$"
            }
        },
        "JsonObject": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {},
            "description": "An open JSON object, not an arbitrary JSON value."
        }
    }
}