{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://responsibleai.github.io/agent-hooks/schema/draft/PreModelCallRequest.json",
    "type": "object",
    "properties": {
        "spec": {
            "type": "string",
            "const": "agent-hooks/draft",
            "description": "This version's wire string (§4.1). A released version's contexts\ncarry that version's own string, agent-hooks/<major>.<minor>."
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "sequence": {
            "type": "integer",
            "minimum": 0
        },
        "agent": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "framework": {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]+$"
                },
                "name": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "framework"
            ]
        },
        "session": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "started_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "turn": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "required": [
                "id"
            ]
        },
        "trace": {
            "type": "object",
            "properties": {
                "trace_id": {
                    "type": "string"
                },
                "span_id": {
                    "type": "string"
                }
            }
        },
        "tenant": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "actor": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "kind": {
                    "$ref": "#/$defs/ActorKind"
                }
            }
        },
        "budgets": {
            "type": "object",
            "properties": {
                "tool_call_count": {
                    "type": "number"
                },
                "token_count": {
                    "type": "number"
                },
                "elapsed_seconds": {
                    "type": "number"
                },
                "cost_usd": {
                    "type": "number"
                }
            }
        },
        "interception_point": {
            "type": "string",
            "const": "pre_model_call"
        },
        "extensions": {
            "$ref": "#/$defs/Extensions"
        },
        "messages": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/Message"
            }
        },
        "tools": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/ToolDecl"
            }
        },
        "request_id": {
            "type": "string"
        },
        "model": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "vendor": {
                    "type": "string"
                },
                "params": {
                    "$ref": "#/$defs/JsonObject"
                }
            },
            "required": [
                "id"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        }
    },
    "required": [
        "spec",
        "timestamp",
        "sequence",
        "agent",
        "session",
        "interception_point",
        "messages",
        "model"
    ],
    "description": "Candidate request at pre_model_call, with a closed required model payload.",
    "title": "Agent Hooks pre_model_call request",
    "$defs": {
        "ActorKind": {
            "type": "string",
            "enum": [
                "human",
                "service",
                "agent"
            ],
            "description": "Who acts (§4.5)."
        },
        "Extensions": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {},
            "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
            "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]*$"
            }
        },
        "Message": {
            "type": "object",
            "properties": {
                "role": {
                    "type": "string"
                },
                "content": {}
            },
            "required": [
                "role",
                "content"
            ],
            "description": "One message of the model request (§4.2)."
        },
        "ToolDecl": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "schema": {
                    "$ref": "#/$defs/JsonObject"
                }
            },
            "required": [
                "name"
            ],
            "description": "One declared tool (§4.3)."
        },
        "JsonObject": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {},
            "description": "An open JSON object, not an arbitrary JSON value."
        }
    }
}