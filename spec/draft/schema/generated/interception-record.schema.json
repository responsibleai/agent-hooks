{
  "$id": "https://responsibleai.github.io/agent-hooks/schema/draft/interception-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks - interception record",
  "description": "Host-side, payload-free record of one emission (section 10.3).\nConditional JSON Schema keywords express relationships between members.\n[allow](../examples/InterceptionRecord/allow.json)\n[approved transform](../examples/InterceptionRecord/approved-transform.json)\n[continued timeout](../examples/InterceptionRecord/continued-after-timeout.json)",
  "type": "object",
  "properties": {
    "interception_point": {
      "$ref": "#/$defs/InterceptionPoint"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "verdict": {
      "$ref": "#/$defs/VerdictProjection"
    },
    "input_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Identity before dispatch; null iff identity_provider is null."
    },
    "enforced_identity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Identity after composition; null iff identity_provider is null."
    },
    "identity_provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "pattern": "^(jcs-sha256|(?!jcs)[a-z][a-z0-9_-]*)$"
    },
    "session_id": {
      "type": "string",
      "description": "ctx.session.id correlates records across a session."
    },
    "sequence": {
      "type": "integer",
      "description": "ctx.sequence totally orders the records within a session."
    },
    "timestamp": {
      "type": "string",
      "description": "Context timestamp, copied verbatim when present."
    },
    "trace": {
      "$ref": "#/$defs/Trace"
    },
    "decided_by": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "minimum": 0,
      "description": "Winning registration index; null for pure-allow or synthesized results."
    },
    "composition": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/$defs/CompositionProfile"
        },
        "on_approval": {
          "$ref": "#/$defs/OnApproval"
        },
        "on_disagreement": {
          "$ref": "#/$defs/ConflictResolution"
        },
        "on_transform_conflict": {
          "$ref": "#/$defs/ConflictResolution"
        }
      },
      "required": [
        "profile"
      ],
      "additionalProperties": false
    },
    "verdicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VerdictSlot"
      },
      "description": "Required for multi-verdict profiles; runtime also requires failure slots."
    },
    "fold_truncated": {
      "type": "boolean",
      "description": "Whether sequential dispatch skipped any registered interceptor."
    },
    "resolved_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResolvedBy"
        },
        {
          "type": "null"
        }
      ],
      "description": "Absent or null when the approval seam was never consulted."
    },
    "interceptors_registered": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "interception_point",
    "mode",
    "verdict",
    "input_identity",
    "enforced_identity",
    "identity_provider",
    "session_id",
    "sequence",
    "composition",
    "interceptors_registered"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "composition": {
            "type": "object",
            "properties": {
              "profile": {
                "enum": [
                  "sequential/run_all",
                  "parallel/strictest",
                  "parallel/unanimous"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "verdicts"
        ]
      }
    },
    {
      "description": "Identities are null when identity_provider is null (section 10.3).",
      "if": {
        "properties": {
          "identity_provider": {
            "const": null
          }
        }
      },
      "then": {
        "properties": {
          "input_identity": {
            "const": null
          },
          "enforced_identity": {
            "const": null
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "InterceptionPoint": {
      "type": "string",
      "enum": [
        "agent_startup",
        "input",
        "pre_model_call",
        "post_model_call",
        "pre_tool_call",
        "post_tool_call",
        "output",
        "agent_shutdown"
      ],
      "description": "The closed set of agent lifecycle interception points (section 3).",
      "title": "Agent Hooks - interception point"
    },
    "Mode": {
      "type": "string",
      "enum": [
        "enforce",
        "evaluate_only"
      ],
      "description": "Enforcement modes (section 8)."
    },
    "VerdictProjection": {
      "type": "object",
      "properties": {
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/WarningProjection"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "approval": {
          "$ref": "#/$defs/ApprovalPresence"
        }
      },
      "required": [
        "decision"
      ],
      "description": "Payload-free combined verdict: transforms are omitted, approval members\nstripped, and messages truncated to 256 UTF-8 bytes by the runtime.\nWarning reasons may carry host_warning:control_failed.",
      "additionalProperties": false
    },
    "Decision": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "transform"
      ]
    },
    "WarningProjection": {
      "type": "object",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Warning metadata retained in a payload-free record projection.",
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "artefact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification_pointers": {
          "$ref": "#/$defs/VerificationPointers"
        }
      },
      "description": "Offline-verifiable evidence attached to a verdict (section 14).",
      "additionalProperties": false
    },
    "VerificationPointers": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {
        "type": "string"
      },
      "description": "Named URIs an auditor may consult; hosts must not dereference automatically."
    },
    "ApprovalPresence": {
      "type": "object",
      "properties": {},
      "description": "Presence only; members are stripped by the record projection.",
      "additionalProperties": false
    },
    "Trace": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        }
      },
      "description": "W3C Trace Context identifiers echoed from the context.",
      "additionalProperties": false
    },
    "CompositionProfile": {
      "type": "string",
      "enum": [
        "sequential/first_deny",
        "sequential/run_all",
        "parallel/strictest",
        "parallel/unanimous"
      ],
      "description": "Composition profiles (section 7.1)."
    },
    "OnApproval": {
      "type": "string",
      "enum": [
        "stop",
        "resume"
      ],
      "description": "Values of the on_approval knob (section 7.2)."
    },
    "ConflictResolution": {
      "type": "string",
      "enum": [
        "deny",
        "approval"
      ],
      "description": "Values of the on_disagreement and on_transform_conflict knobs."
    },
    "VerdictSlot": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "description": "Host-chosen, payload-free registration identifier."
        },
        "substituted_for": {
          "$ref": "#/$defs/SubstitutedFor",
          "description": "Failure replaced with an allow by on_error: continue."
        }
      },
      "required": [
        "index",
        "decision"
      ],
      "description": "Payload-free summary of one interceptor's verdict (section 10.3).",
      "additionalProperties": false
    },
    "SubstitutedFor": {
      "type": "string",
      "enum": [
        "host_error:interceptor_failed",
        "host_error:interceptor_timeout",
        "host_error:verdict_invalid"
      ]
    },
    "ResolvedBy": {
      "type": "string",
      "enum": [
        "approval",
        "rejection"
      ]
    }
  }
}
