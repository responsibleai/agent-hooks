{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://responsibleai.github.io/agent-hooks/schema/draft/PostModelCallRequest.json",
    "type": "object",
    "properties": {
        "spec": {
            "type": "string",
            "const": "agent-hooks/draft",
            "description": "This version's wire string (§4.1). A released version's contexts\ncarry that version's own string, agent-hooks/<major>.<minor>."
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "sequence": {
            "type": "integer",
            "minimum": 0
        },
        "agent": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "framework": {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]+$"
                },
                "name": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "framework"
            ]
        },
        "session": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "started_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "turn": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "required": [
                "id"
            ]
        },
        "trace": {
            "type": "object",
            "properties": {
                "trace_id": {
                    "type": "string"
                },
                "span_id": {
                    "type": "string"
                }
            }
        },
        "tenant": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "actor": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "kind": {
                    "$ref": "#/$defs/ActorKind"
                }
            }
        },
        "budgets": {
            "type": "object",
            "properties": {
                "tool_call_count": {
                    "type": "number"
                },
                "token_count": {
                    "type": "number"
                },
                "elapsed_seconds": {
                    "type": "number"
                },
                "cost_usd": {
                    "type": "number"
                }
            }
        },
        "interception_point": {
            "type": "string",
            "const": "post_model_call"
        },
        "extensions": {
            "$ref": "#/$defs/Extensions"
        },
        "request_id": {
            "type": "string"
        },
        "usage": {
            "$ref": "#/$defs/Usage"
        },
        "model": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "vendor": {
                    "type": "string"
                },
                "params": {
                    "$ref": "#/$defs/JsonObject"
                }
            },
            "required": [
                "id"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "response": {
            "type": "object",
            "properties": {
                "content": {},
                "tool_calls": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ToolCallRequest"
                    }
                },
                "finish_reason": {
                    "type": "string"
                }
            },
            "required": [
                "content",
                "tool_calls",
                "finish_reason"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        }
    },
    "required": [
        "spec",
        "timestamp",
        "sequence",
        "agent",
        "session",
        "interception_point",
        "model",
        "response"
    ],
    "description": "Candidate request at post_model_call, with closed required object payloads.",
    "title": "Agent Hooks post_model_call request",
    "$defs": {
        "ActorKind": {
            "type": "string",
            "enum": [
                "human",
                "service",
                "agent"
            ],
            "description": "Who acts (§4.5)."
        },
        "Extensions": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {},
            "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
            "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]*$"
            }
        },
        "Usage": {
            "type": "object",
            "properties": {
                "prompt_tokens": {
                    "type": "integer",
                    "minimum": 0
                },
                "completion_tokens": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "description": "Token usage of a model call (§4.3)."
        },
        "JsonObject": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {},
            "description": "An open JSON object, not an arbitrary JSON value."
        },
        "ToolCallRequest": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "args": {
                    "$ref": "#/$defs/JsonObject"
                }
            },
            "required": [
                "name",
                "args"
            ],
            "description": "One tool call the model asked for (§4.2)."
        }
    }
}