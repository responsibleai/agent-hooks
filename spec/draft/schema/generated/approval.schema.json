{
  "$id": "https://responsibleai.github.io/agent-hooks/schema/draft/approval.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks — approval seam",
  "description": "Approval request and resolution shapes for lifting a liftable deny (AGENT-HOOKS-0.1 §9). context_identity is an opaque provider-produced string, or null when identity_provider is null (§10.1); the only normative constraint is the echo rule.",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "context_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "interception_point": {
          "$ref": "#/$defs/InterceptionPoint"
        },
        "verdict": {
          "$ref": "#/$defs/LiftableDeny"
        },
        "context": {
          "$ref": "#/$defs/AgentContext",
          "description": "The context as presented to the resolver; may be redacted."
        }
      },
      "required": [
        "context_identity",
        "interception_point",
        "verdict"
      ],
      "description": "What the host hands the resolver (section 9).\nThe public fragment remains approval.schema.json#/$defs/request.\n[request](../examples/ApprovalRequest/collection-access.json)",
      "additionalProperties": false
    },
    "InterceptionPoint": {
      "type": "string",
      "enum": [
        "agent_startup",
        "input",
        "pre_model_call",
        "post_model_call",
        "pre_tool_call",
        "post_tool_call",
        "output",
        "agent_shutdown"
      ],
      "description": "The closed set of agent lifecycle interception points (section 3).",
      "title": "Agent Hooks - interception point"
    },
    "LiftableDeny": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "const": "deny"
        }
      },
      "required": [
        "decision"
      ],
      "unevaluatedProperties": {},
      "description": "A consulted deny may carry a host-synthesized host_error reason."
    },
    "AgentContext": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentStartupRequest"
        },
        {
          "$ref": "#/$defs/InputRequest"
        },
        {
          "$ref": "#/$defs/PreModelCallRequest"
        },
        {
          "$ref": "#/$defs/PostModelCallRequest"
        },
        {
          "$ref": "#/$defs/PreToolCallRequest"
        },
        {
          "$ref": "#/$defs/PostToolCallRequest"
        },
        {
          "$ref": "#/$defs/OutputRequest"
        },
        {
          "$ref": "#/$defs/AgentShutdownRequest"
        }
      ],
      "description": "Payload a host constructs at each interception point (section 4).",
      "title": "Agent Hooks - agent context"
    },
    "AgentStartupRequest": {
      "type": "object",
      "properties": {
        "spec": {
          "type": "string",
          "const": "agent-hooks/draft",
          "description": "This bundle's wire string, rewritten when a specification is cut."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "agent": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "framework": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "framework"
          ]
        },
        "session": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "turn": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "id"
          ]
        },
        "trace": {
          "type": "object",
          "properties": {
            "trace_id": {
              "type": "string"
            },
            "span_id": {
              "type": "string"
            }
          }
        },
        "tenant": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "actor": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/ActorKind"
            }
          }
        },
        "budgets": {
          "type": "object",
          "properties": {
            "tool_call_count": {
              "type": "number"
            },
            "token_count": {
              "type": "number"
            },
            "elapsed_seconds": {
              "type": "number"
            },
            "cost_usd": {
              "type": "number"
            }
          }
        },
        "interception_point": {
          "type": "string",
          "const": "agent_startup"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "agent_init": {
          "$ref": "#/$defs/AgentInit"
        }
      },
      "required": [
        "spec",
        "timestamp",
        "sequence",
        "agent",
        "session",
        "interception_point",
        "agent_init"
      ],
      "description": "The request at agent_startup.\n[agent-startup.json](../examples/AgentContext/agent-startup.json)"
    },
    "ActorKind": {
      "type": "string",
      "enum": [
        "human",
        "service",
        "agent"
      ]
    },
    "Extensions": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {},
      "description": "Namespaced extensions (section 4.6); values are unconstrained JSON.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "AgentInit": {
      "type": "object",
      "properties": {
        "tools_registered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "tools_registered"
      ],
      "description": "Conditional payload of agent_startup (section 4.2)."
    },
