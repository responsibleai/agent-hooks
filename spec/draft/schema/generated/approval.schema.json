{
  "$id": "https://responsibleai.github.io/agent-hooks/schema/draft/approval.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks — approval seam",
  "description": "Approval request and resolution shapes for lifting a liftable deny (AGENT-HOOKS-0.1 §9). context_identity is an opaque provider-produced string, or null when identity_provider is null (§10.1); the only normative constraint is the echo rule.",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "context_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "interception_point": {
          "$ref": "#/$defs/InterceptionPoint"
        },
        "verdict": {
          "$ref": "#/$defs/LiftableDeny"
        },
        "context": {
          "$ref": "#/$defs/AgentContext",
          "description": "The AgentContext as presented to the resolver. MAY be redacted per host policy."
        }
      },
      "required": [
        "context_identity",
        "interception_point",
        "verdict"
      ],
      "description": "What the host hands the resolver (§9).",
      "additionalProperties": false
    },
    "resolution": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApproveResolution"
        },
        {
          "$ref": "#/$defs/RejectResolution"
        },
        {
          "$ref": "#/$defs/UnresolvedResolution"
        }
      ],
      "description": "What the resolver returns (§9)."
    },
    "Outcome": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "unresolved"
      ],
      "description": "How a consultation ended (§9)."
    },
    "LiftableDeny": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "const": "deny"
        }
      },
      "required": [
        "decision"
      ],
      "unevaluatedProperties": {},
      "description": "The liftable deny being consulted: an interceptor's (passes §5,\nverdict.schema.json) or the host-synthesized §7.5 shape, whose reason is a\nreserved host_error:* string that §5 forbids interceptors to emit — so this\nmember is validated against the §5 schema only when its reason is not\nhost_error:*."
    },
    "ApproveResolution": {
      "type": "object",
      "properties": {
        "context_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "MUST equal the request's context_identity byte for byte (echo rule, §9);\nnull echoes as null."
        },
        "outcome": {
          "type": "string",
          "const": "approve"
        },
        "verdict": {
          "$ref": "#/$defs/AllowVerdict"
        }
      },
      "required": [
        "context_identity",
        "outcome",
        "verdict"
      ],
      "description": "approve: the resolver lifts the deny with an allow verdict.",
      "additionalProperties": false
    },
    "RejectResolution": {
      "type": "object",
      "properties": {
        "context_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "MUST equal the request's context_identity byte for byte (echo rule, §9);\nnull echoes as null."
        },
        "outcome": {
          "type": "string",
          "const": "reject"
        },
        "verdict": {
          "$ref": "#/$defs/DenyVerdict"
        }
      },
      "required": [
        "context_identity",
        "outcome",
        "verdict"
      ],
      "description": "reject: the resolver keeps a deny.",
      "additionalProperties": false
    },
    "UnresolvedResolution": {
      "type": "object",
      "properties": {
        "context_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "MUST equal the request's context_identity byte for byte (echo rule, §9);\nnull echoes as null."
        },
        "outcome": {
          "type": "string",
          "const": "unresolved"
        }
      },
      "required": [
        "context_identity",
        "outcome"
      ],
      "description": "unresolved: no decision; the deny stands and no verdict is carried.",
      "additionalProperties": false
    },
    "InterceptionPoint": {
      "type": "string",
      "enum": [
        "agent_startup",
        "input",
        "pre_model_call",
        "post_model_call",
        "pre_tool_call",
        "post_tool_call",
        "output",
        "agent_shutdown"
      ],
      "description": "The closed set of agent lifecycle interception points (AGENT-HOOKS-0.1 §3).",
      "title": "Agent Hooks — interception point"
    },
    "AgentContext": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentStartupRequest"
        },
        {
          "$ref": "#/$defs/InputRequest"
        },
        {
          "$ref": "#/$defs/PreModelCallRequest"
        },
        {
          "$ref": "#/$defs/PostModelCallRequest"
        },
        {
          "$ref": "#/$defs/PreToolCallRequest"
        },
        {
          "$ref": "#/$defs/PostToolCallRequest"
        },
        {
          "$ref": "#/$defs/OutputRequest"
        },
        {
          "$ref": "#/$defs/AgentShutdownRequest"
        }
      ],
      "description": "Payload a host constructs at each interception point (AGENT-HOOKS-0.1 §4).\nEach variant requires its discriminator and own hook payload, with shared\nmetadata and optional namespaced extensions.",
      "title": "Agent Hooks — agent context"
    },
    "AllowVerdict": {
      "type": "object",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(?!host_error:).*",
          "description": "Interceptor-supplied machine identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11)."
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable text for the caller."
        },
        "warnings": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Recorded concerns that do not affect control flow (§5.1). Permitted on any\ndecision; unioned across an emission's verdicts (§7.3). Reasons starting with\nhost_warning: are reserved for the host (§11.1)."
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Interceptor-supplied labels the host MUST persist with the produced data and\nresurface on later interception points (§5.4)."
        },
        "decision": {
          "type": "string",
          "const": "allow"
        }
      },
      "required": [
        "decision"
      ],
      "description": "allow: proceed. Absorbs warn through warnings[] (§5.1).",
      "additionalProperties": false
    },
    "DenyVerdict": {
      "type": "object",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(?!host_error:).*",
          "description": "Interceptor-supplied machine identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11)."
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable text for the caller."
        },
        "warnings": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Recorded concerns that do not affect control flow (§5.1). Permitted on any\ndecision; unioned across an emission's verdicts (§7.3). Reasons starting with\nhost_warning: are reserved for the host (§11.1)."
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Interceptor-supplied labels the host MUST persist with the produced data and\nresurface on later interception points (§5.4)."
        },
        "decision": {
          "type": "string",
          "const": "deny"
        },
        "approval": {
          "$ref": "#/$defs/JsonObject",
          "description": "Present only on deny: marks the deny as liftable by the approval seam (§9).\nMAY be empty; reserved for approver-facing parameters."
        }
      },
      "required": [
        "decision"
      ],
      "description": "deny: stop the action. Absorbs escalate through the approval block (§5.1).",
      "additionalProperties": false
    },
    "AgentStartupRequest": {
      "type": "object",
      "properties": {
        "spec": {
          "type": "string",
          "const": "agent-hooks/draft",
