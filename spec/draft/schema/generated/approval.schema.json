            },
            "turn": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "id"
          ]
        },
        "extensions": {
          "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "agent",
        "interception_point",
        "messages",
        "model",
        "sequence",
        "session",
        "spec",
        "timestamp"
      ]
    },
    "Model": {
      "description": "Conditional payload of pre_model_call and post_model_call (§4.2).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        }
      },
      "required": [
        "id"
      ]
    },
    "Message": {
      "description": "One message of the model request (§4.2).",
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "content": {}
      },
      "required": [
        "content",
        "role"
      ]
    },
    "PostModelCallRequest": {
      "description": "The request at post_model_call: model and response are required (§4.2).",
      "type": "object",
      "properties": {
        "interception_point": {
          "type": "string",
          "const": "post_model_call"
        },
        "model": {
          "$ref": "#/$defs/Model"
        },
        "response": {
          "$ref": "#/$defs/Response"
        },
        "spec": {
          "pattern": "^agent-hooks/\\d+\\.\\d+$",
