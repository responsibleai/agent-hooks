{
  "$id": "https://responsibleai.github.io/agent-hooks/schema/v0.1/approval.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks — approval seam",
  "description": "Approval request and resolution shapes for lifting a liftable deny (AGENT-HOOKS-0.1 §9). context_identity is an opaque provider-produced string, or null when identity_provider is null (§10.1); the only normative constraint is the echo rule.",
  "$defs": {
    "LiftableDeny": {
      "description": "The liftable deny being consulted: an interceptor's (passes §5,\nverdict.schema.json) or the host-synthesized §7.5 shape, whose reason is a\nreserved host_error:* string that §5 forbids interceptors to emit — so this\nmember is validated against the §5 schema only when its reason is not\nhost_error:*.",
      "type": "object",
      "additionalProperties": {},
      "properties": {
        "decision": {
          "type": "string",
          "const": "deny"
        }
      },
      "required": [
        "decision"
      ]
    },
    "request": {
      "description": "What the host hands the resolver (§9).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "context_identity": {
          "type": [
            "null",
            "string"
          ]
        },
        "interception_point": {
          "$ref": "#/$defs/InterceptionPoint"
        },
        "verdict": {
          "$ref": "#/$defs/LiftableDeny"
        },
        "context": {
          "description": "The AgentContext as presented to the resolver. MAY be redacted per host policy.",
          "title": "Agent Hooks — agent context",
          "anyOf": [
            {
              "$ref": "#/$defs/AgentStartupRequest"
            },
            {
              "$ref": "#/$defs/InputRequest"
            },
            {
              "$ref": "#/$defs/PreModelCallRequest"
            },
            {
              "$ref": "#/$defs/PostModelCallRequest"
            },
            {
              "$ref": "#/$defs/PreToolCallRequest"
            },
            {
              "$ref": "#/$defs/PostToolCallRequest"
            },
            {
              "$ref": "#/$defs/OutputRequest"
            },
            {
              "$ref": "#/$defs/AgentShutdownRequest"
            }
          ]
        }
      },
      "required": [
        "context_identity",
        "interception_point",
        "verdict"
      ]
    },
    "Outcome": {
      "description": "How a consultation ended (§9).",
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "unresolved"
      ]
    },
    "ResolutionBase": {
      "type": "object",
      "properties": {
        "context_identity": {
          "description": "MUST equal the request's context_identity byte for byte (echo rule, §9);\nnull echoes as null.",
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "context_identity"
      ]
    },
    "ApproveResolution": {
      "description": "approve: the resolver lifts the deny with an allow or transform verdict.",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "const": "approve"
        },
        "verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/AllowVerdict"
            },
            {
              "$ref": "#/$defs/TransformVerdict"
            }
          ]
        },
        "context_identity": {
          "description": "MUST equal the request's context_identity byte for byte (echo rule, §9);\nnull echoes as null.",
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "context_identity",
        "outcome",
        "verdict"
      ]
    },
    "RejectResolution": {
      "description": "reject: the resolver keeps a deny.",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "const": "reject"
        },
        "verdict": {
          "$ref": "#/$defs/DenyVerdict"
        },
        "context_identity": {
          "description": "MUST equal the request's context_identity byte for byte (echo rule, §9);\nnull echoes as null.",
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "context_identity",
        "outcome",
        "verdict"
      ]
    },
    "UnresolvedResolution": {
      "description": "unresolved: no decision; the deny stands and no verdict is carried.",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "const": "unresolved"
        },
        "context_identity": {
          "description": "MUST equal the request's context_identity byte for byte (echo rule, §9);\nnull echoes as null.",
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "context_identity",
        "outcome"
      ]
    },
    "resolution": {
      "description": "What the resolver returns (§9).",
      "anyOf": [
        {
          "$ref": "#/$defs/ApproveResolution"
        },
        {
          "$ref": "#/$defs/RejectResolution"
        },
        {
          "$ref": "#/$defs/UnresolvedResolution"
        }
      ]
    },
    "InterceptionPoint": {
      "description": "The closed set of agent lifecycle interception points (AGENT-HOOKS-0.1 §3).",
      "title": "Agent Hooks — interception point",
      "type": "string",
      "enum": [
        "agent_startup",
        "input",
        "pre_model_call",
        "post_model_call",
        "pre_tool_call",
        "post_tool_call",
        "output",
        "agent_shutdown"
      ]
    },
    "AgentStartupRequest": {
      "description": "The request at agent_startup: agent_init is required (§4.2).",
      "type": "object",
      "properties": {
        "interception_point": {
          "type": "string",
          "const": "agent_startup"
        },
        "agent_init": {
          "$ref": "#/$defs/AgentInit"
        },
        "spec": {
          "pattern": "^agent-hooks/\\d+\\.\\d+$",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "agent": {
          "type": "object",
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "framework": {
              "pattern": "^[a-z0-9_-]+$",
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "framework",
            "id"
          ]
        },
        "session": {
          "type": "object",
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "started_at": {
              "format": "date-time",
              "type": "string"
            },
            "turn": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "id"
          ]
        },
        "extensions": {
          "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "agent",
        "agent_init",
        "interception_point",
        "sequence",
        "session",
        "spec",
        "timestamp"
      ]
    },
    "AgentInit": {
      "description": "Conditional payload of agent_startup (§4.2).",
      "type": "object",
      "properties": {
        "tools_registered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "tools_registered"
      ]
    },
    "Extensions": {
      "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "type": "object",
      "additionalProperties": {}
    },
    "InputRequest": {
      "description": "The request at input: input is required (§4.2).",
      "type": "object",
      "properties": {
        "interception_point": {
          "type": "string",
          "const": "input"
        },
        "input": {
          "$ref": "#/$defs/Input"
        },
        "spec": {
          "pattern": "^agent-hooks/\\d+\\.\\d+$",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "agent": {
          "type": "object",
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "framework": {
              "pattern": "^[a-z0-9_-]+$",
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "framework",
            "id"
          ]
        },
        "session": {
          "type": "object",
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "started_at": {
              "format": "date-time",
              "type": "string"
            },
            "turn": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "id"
          ]
        },
        "extensions": {
          "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "agent",
        "input",
        "interception_point",
        "sequence",
        "session",
        "spec",
        "timestamp"
      ]
    },
    "Input": {
      "description": "Conditional payload of input (§4.2).",
      "type": "object",
      "properties": {
        "content": {},
        "role": {
          "$ref": "#/$defs/InputRole"
        }
      },
      "required": [
        "content",
        "role"
      ]
    },
    "InputRole": {
      "description": "Who produced an input (§4.2).",
      "type": "string",
      "enum": [
        "user",
        "system",
        "external"
      ]
    },
