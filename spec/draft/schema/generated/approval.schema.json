        },
        "interception_point": {
          "type": "string",
          "const": "agent_startup"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "agent_init": {
          "$ref": "#/$defs/AgentInit"
        }
      },
      "required": [
        "spec",
        "timestamp",
        "sequence",
        "agent",
        "session",
        "interception_point",
        "agent_init"
      ],
      "description": "The request at agent_startup: agent_init is required (§4.2)."
    },
