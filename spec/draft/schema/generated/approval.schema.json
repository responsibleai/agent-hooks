        "session": {
          "type": "object",
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "started_at": {
              "format": "date-time",
              "type": "string"
            },
            "turn": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "id"
          ]
        },
        "extensions": {
          "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "agent",
        "interception_point",
        "sequence",
        "session",
        "spec",
        "summary",
        "timestamp"
      ]
    },
    "Summary": {
      "description": "Conditional payload of agent_shutdown (§4.2).",
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/$defs/SummaryReason"
        },
        "tool_calls": {
          "minimum": 0,
          "type": "integer"
        },
        "errors": {
          "minimum": 0,
          "type": "integer"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "reason"
      ]
    },
    "SummaryReason": {
      "description": "Why the agent stopped (§4.2).",
      "type": "string",
      "enum": [
        "completed",
        "error",
        "cancelled"
      ]
    },
    "AllowVerdict": {
      "description": "allow: proceed. Absorbs warn through warnings[] (§5.1).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "const": "allow"
        },
        "reason": {
          "description": "Interceptor-supplied machine identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11).",
          "pattern": "^(?!host_error:).*",
          "type": [
            "null",
            "string"
          ]
        },
        "message": {
          "description": "Human-readable text for the caller.",
          "type": [
            "null",
            "string"
          ]
        },
        "warnings": {
          "description": "Recorded concerns that do not affect control flow (§5.1). Permitted on any\ndecision; unioned across an emission's verdicts (§7.3). Reasons starting with\nhost_warning: are reserved for the host (§11.1).",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "description": "Offline-verifiable evidence attached to a verdict (§14).",
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "description": "Interceptor-supplied labels the host MUST persist with the produced data and\nresurface on later interception points (§5.4).",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "decision"
      ]
    },
    "Warning": {
      "description": "A recorded concern that does not affect control flow (§5.1).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "reason": {
          "description": "Interceptor-supplied warning identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11) and host_warning: for host-synthesized\nwarnings (§11.1); an interceptor warning with either prefix fails §5\nvalidation.",
          "pattern": "^(?!host_error:|host_warning:).*",
          "type": [
            "null",
            "string"
          ]
        },
        "message": {
          "type": [
            "null",
            "string"
          ]
        }
      }
    },
    "Evidence": {
      "description": "Offline-verifiable evidence attached to a verdict (§14).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "artefact": {
          "description": "Content address (sha256:<hex>) or URI of an offline-verifiable proof.",
          "type": [
            "null",
            "string"
          ]
        },
        "verification_pointers": {
          "description": "Named URIs an auditor MAY consult. Hosts MUST NOT dereference automatically (§14).",
          "$ref": "#/$defs/VerificationPointers"
        }
      }
    },
    "VerificationPointers": {
      "description": "Named URIs an auditor MAY consult. Hosts MUST NOT dereference automatically (§14).",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "Transform": {
      "description": "The transform body (§5.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "path": {
          "description": "JSONPath rooted at $target (§5.2). $policy_target is a deprecated alias\naccepted through agent-hooks v0.2.",
          "pattern": "^\\$(target|policy_target)(\\.|\\[|$)",
          "type": "string"
        },
        "value": {
          "description": "Any JSON value, including null. An absent member is equivalent to null (§5.2)."
        }
      },
      "required": [
        "path"
      ]
    },
    "DenyVerdict": {
      "description": "deny: stop the action. Absorbs escalate through the approval block (§5.1).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "const": "deny"
        },
        "approval": {
          "description": "Present only on deny: marks the deny as liftable by the approval seam (§9).\nMAY be empty; reserved for approver-facing parameters.",
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "reason": {
          "description": "Interceptor-supplied machine identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11).",
          "pattern": "^(?!host_error:).*",
          "type": [
            "null",
            "string"
          ]
        },
        "message": {
          "description": "Human-readable text for the caller.",
          "type": [
            "null",
            "string"
          ]
        },
        "warnings": {
          "description": "Recorded concerns that do not affect control flow (§5.1). Permitted on any\ndecision; unioned across an emission's verdicts (§7.3). Reasons starting with\nhost_warning: are reserved for the host (§11.1).",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "description": "Offline-verifiable evidence attached to a verdict (§14).",
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "description": "Interceptor-supplied labels the host MUST persist with the produced data and\nresurface on later interception points (§5.4).",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "decision"
      ]
    },
    "TransformVerdict": {
      "description": "transform: proceed with the target rewritten. The transform body is REQUIRED (§5).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "const": "transform"
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        },
        "reason": {
          "description": "Interceptor-supplied machine identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11).",
          "pattern": "^(?!host_error:).*",
          "type": [
            "null",
            "string"
          ]
        },
        "message": {
          "description": "Human-readable text for the caller.",
          "type": [
            "null",
            "string"
          ]
        },
        "warnings": {
          "description": "Recorded concerns that do not affect control flow (§5.1). Permitted on any\ndecision; unioned across an emission's verdicts (§7.3). Reasons starting with\nhost_warning: are reserved for the host (§11.1).",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "description": "Offline-verifiable evidence attached to a verdict (§14).",
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "description": "Interceptor-supplied labels the host MUST persist with the produced data and\nresurface on later interception points (§5.4).",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "decision",
        "transform"
      ]
    }
  }
}
