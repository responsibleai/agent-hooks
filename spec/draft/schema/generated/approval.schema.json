      "properties": {
        "content": {},
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolCallRequest"
          }
        },
        "finish_reason": {
          "type": "string"
        }
      },
      "required": [
        "content",
        "finish_reason",
        "tool_calls"
      ]
    },
    "ToolCallRequest": {
      "description": "One tool call the model asked for (§4.2).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        }
      },
      "required": [
        "args",
        "name"
      ]
    },
