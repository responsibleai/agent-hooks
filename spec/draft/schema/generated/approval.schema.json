            "token_count": {
              "type": "number"
            },
            "elapsed_seconds": {
              "type": "number"
            },
            "cost_usd": {
              "type": "number"
            }
          }
        },
        "interception_point": {
          "type": "string",
          "const": "input"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "input": {
          "$ref": "#/$defs/Input"
        }
      },
      "required": [
        "spec",
        "timestamp",
        "sequence",
        "agent",
        "session",
        "interception_point",
        "input"
      ],
      "description": "The request at input.\n[input.json](../examples/AgentContext/input.json)"
    },
    "Input": {
      "type": "object",
      "properties": {
        "content": {},
        "role": {
          "$ref": "#/$defs/InputRole"
        }
      },
      "required": [
        "content",
        "role"
      ]
    },
    "InputRole": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "external"
