          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "turn": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "id"
          ]
        },
        "trace": {
          "type": "object",
          "properties": {
            "trace_id": {
              "type": "string"
            },
            "span_id": {
              "type": "string"
            }
          }
        },
        "tenant": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "actor": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/ActorKind"
            }
          }
        },
        "budgets": {
          "type": "object",
          "properties": {
            "tool_call_count": {
              "type": "number"
            },
            "token_count": {
              "type": "number"
            },
            "elapsed_seconds": {
              "type": "number"
            },
            "cost_usd": {
              "type": "number"
