{
  "$id": "https://responsibleai.github.io/agent-hooks/schema/draft/post-model-hook-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks — post_model_call response",
  "description": "Post-model responses.\n[allow](../examples/PostModelHookResponse/allow.json)\n[deny](../examples/PostModelHookResponse/deny.json)\n[transform](../examples/PostModelHookResponse/transform.json)",
  "type": "object",
  "properties": {
    "verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/AllowVerdict"
        },
        {
          "$ref": "#/$defs/DenyVerdict"
        },
        {
          "$ref": "#/$defs/TransformVerdictPostModelHookTransform"
        }
      ]
    },
    "extensions": {
      "$ref": "#/$defs/Extensions"
    }
  },
  "required": [
    "verdict"
  ],
  "additionalProperties": false,
  "$defs": {
    "AllowVerdict": {
      "type": "object",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(?!host_error:).*"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Labels the host persists with produced data and resurfaces at later hooks."
        },
        "decision": {
          "type": "string",
          "const": "allow"
        }
      },
      "required": [
        "decision"
      ],
      "description": "Proceed; warnings do not affect control flow.\n[allow](../examples/Verdict/allow.json)\n[with warning](../examples/Verdict/allow-with-warning.json)\n[with evidence](../examples/Verdict/allow-with-evidence.json)",
      "additionalProperties": false
    },
    "Warning": {
      "type": "object",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(?!host_error:|host_warning:).*",
          "description": "Host error and warning namespaces are reserved for the host."
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "A recorded concern that does not affect control flow (section 5.1).",
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "artefact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification_pointers": {
          "$ref": "#/$defs/VerificationPointers"
        }
      },
      "description": "Offline-verifiable evidence attached to a verdict (section 14).",
      "additionalProperties": false
    },
    "VerificationPointers": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {
        "type": "string"
      },
      "description": "Named URIs an auditor may consult; hosts must not dereference automatically."
    },
    "DenyVerdict": {
      "type": "object",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(?!host_error:).*"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Labels the host persists with produced data and resurfaces at later hooks."
        },
        "decision": {
          "type": "string",
          "const": "deny"
        },
        "approval": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "decision"
      ],
      "description": "Stop the action; an approval block makes the deny liftable.\n[deny](../examples/Verdict/deny.json)\n[with approval](../examples/Verdict/deny-with-approval.json)",
      "additionalProperties": false
    },
    "JsonObject": {
      "type": "object",
      "properties": {},
      "description": "An open JSON object, not an arbitrary JSON value."
    },
    "TransformVerdictPostModelHookTransform": {
      "type": "object",
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(?!host_error:).*"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Warning"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "result_labels": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Labels the host persists with produced data and resurfaces at later hooks."
        },
        "decision": {
          "type": "string",
          "const": "transform"
        },
        "transform": {
          "$ref": "#/$defs/PostModelHookTransform"
        }
      },
      "required": [
        "decision",
        "transform"
      ],
      "description": "Proceed with the hook-specific replacement payload.\n[input](../examples/Verdict/transform-input.json)\n[messages](../examples/Verdict/transform-messages.json)\n[output](../examples/Verdict/transform-output.json)\n[response](../examples/Verdict/transform-response.json)\n[args](../examples/Verdict/transform-tool-args.json)\n[value](../examples/Verdict/transform-tool-result.json)",
      "additionalProperties": false
    },
    "PostModelHookTransform": {
      "type": "object",
      "properties": {
        "response": {
          "$ref": "#/$defs/Response"
        }
      },
      "required": [
        "response"
      ],
      "description": "Replaces the complete model response payload.",
      "additionalProperties": false
    },
    "Response": {
      "type": "object",
      "properties": {
        "content": {},
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolCallRequest"
          }
        },
        "finish_reason": {
          "type": "string"
        }
      },
      "required": [
        "content",
        "tool_calls",
        "finish_reason"
      ]
    },
    "ToolCallRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "args": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "name",
        "args"
      ]
    },
    "Extensions": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {},
      "description": "Namespaced extensions (section 4.6); values are unconstrained JSON.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  }
}
