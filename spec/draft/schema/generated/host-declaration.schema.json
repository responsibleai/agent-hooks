{
  "$id": "https://responsibleai.github.io/agent-hooks/schema/draft/host-declaration.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks - host declaration document (agent-hooks/draft)",
  "description": "Host declaration whose spec member selects its format and behavior.\nEvery object is closed except binding config and extension values.\nThe loader checks knob consistency, lifecycle floors and registered names.\n[document policy](../examples/HostDeclaration/document-policy.json)\n[default failure posture](../examples/HostDeclaration/default-failure-posture.json)\n[failure posture](../examples/HostDeclaration/failure-posture.json)\n[streaming](../examples/HostDeclaration/streaming-document-policy.json)",
  "type": "object",
  "properties": {
    "configuration": {
      "$ref": "#/$defs/Configuration"
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Binding"
      },
      "maxItems": 256,
      "description": "Required, ordered dispatch list. The loader checks binding id uniqueness."
    },
    "$schema": {
      "type": "string",
      "description": "Ignored by the loader; kept for editors."
    },
    "spec": {
      "type": "string",
      "const": "agent-hooks/draft"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "description": "Operator label for logs, never stamped on records."
    },
    "host": {
      "$ref": "#/$defs/Host"
    },
    "surface": {
      "$ref": "#/$defs/Surface",
      "description": "Must be a subset of the host's implemented surface."
    },
    "extensions": {
      "$ref": "#/$defs/Extensions"
    }
  },
  "required": [
    "bindings",
    "spec"
  ],
  "additionalProperties": false,
  "$defs": {
    "Configuration": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/Mode",
          "default": "enforce"
        },
        "composition": {
          "$ref": "#/$defs/CompositionConfig"
        },
        "identity_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(jcs-sha256|(?!jcs)[a-z][a-z0-9_-]{0,63})$",
          "description": "jcs-sha256, a registered non-jcs custom name, or null for unbound identity."
        },
        "approval": {
          "$ref": "#/$defs/ApprovalConfig"
        },
        "posture": {
          "$ref": "#/$defs/PostureConfig"
        },
        "timeouts": {
          "$ref": "#/$defs/TimeoutsConfig"
        },
        "records": {
          "$ref": "#/$defs/RecordsConfig"
        },
        "failure": {
          "$ref": "#/$defs/FailureConfig"
        }
      },
      "description": "Host configuration; omitted members take the specification's defaults.",
      "additionalProperties": false
    },
    "Mode": {
      "type": "string",
      "enum": [
        "enforce",
        "evaluate_only"
      ],
      "description": "Enforcement modes (section 8)."
    },
    "CompositionConfig": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/$defs/CompositionProfile",
          "default": "sequential/first_deny"
        },
        "on_approval": {
          "$ref": "#/$defs/OnApproval",
          "description": "Consulted only by sequential/first_deny."
        },
        "on_disagreement": {
          "$ref": "#/$defs/ConflictResolution",
          "description": "Consulted only by parallel/unanimous."
        },
        "on_transform_conflict": {
          "$ref": "#/$defs/ConflictResolution",
          "description": "Consulted only by parallel/strictest."
        }
      },
      "description": "Unconsulted profile knobs are refused by the loader, never cleared.",
      "additionalProperties": false
    },
    "CompositionProfile": {
      "type": "string",
      "enum": [
        "sequential/first_deny",
        "sequential/run_all",
        "parallel/strictest",
        "parallel/unanimous"
      ],
      "description": "Composition profiles (section 7.1)."
    },
    "OnApproval": {
      "type": "string",
      "enum": [
        "stop",
        "resume"
      ],
      "description": "Values of the on_approval knob (section 7.2)."
    },
    "ConflictResolution": {
      "type": "string",
      "enum": [
        "deny",
        "approval"
      ],
      "description": "Values of the on_disagreement and on_transform_conflict knobs."
    },
    "ApprovalConfig": {
      "type": "object",
      "properties": {
        "resolver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "description": "Registered resolver, or null to leave liftable denies in force."
        },
        "redactor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "PostureConfig": {
      "type": "object",
      "properties": {
        "tool_seam_host_error": {
          "$ref": "#/$defs/ToolSeamHostError",
          "description": "Must equal the posture implemented by the host.",
          "default": "continue"
        }
      },
      "additionalProperties": false
    },
    "ToolSeamHostError": {
      "type": "string",
      "enum": [
        "continue",
        "terminate"
      ]
    },
    "TimeoutsConfig": {
      "type": "object",
      "properties": {
        "interceptor_ms": {
          "$ref": "#/$defs/TimeoutMs",
          "description": "Default 5000; null explicitly means unbounded."
        },
        "approval_resolver_ms": {
          "$ref": "#/$defs/TimeoutMs",
          "description": "Defaults to interceptor_ms."
        }
      },
      "additionalProperties": false
    },
    "TimeoutMs": {
      "anyOf": [
        {
          "$ref": "#/$defs/BoundedTimeoutMs"
        },
        {
          "type": "null"
        }
      ],
      "description": "A bound in milliseconds; null is unbounded."
    },
    "BoundedTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "RecordsConfig": {
      "type": "object",
      "properties": {
        "max_buffered": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Null is unbounded; finite bounds must canonicalize without rounding."
        }
      },
      "additionalProperties": false
    },
    "FailureConfig": {
      "type": "object",
      "properties": {
        "on_error": {
          "$ref": "#/$defs/OnError",
          "description": "Document default inherited by each binding.",
          "default": "deny"
        }
      },
      "additionalProperties": false
    },
    "OnError": {
      "type": "string",
      "enum": [
        "deny",
        "continue"
      ]
    },
    "Binding": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reference",
          "description": "Unique within bindings; persisted as the verdict slot's name."
        },
        "kind": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
          "description": "Registry lookup key, never a path, class, module or URL to load."
        },
        "config": {
          "description": "Kind-specific JSON passed unchanged to its resolver; defaults to {}."
        },
        "at": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InterceptionPoint"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Defaults to every point in the declared surface."
        },
        "timeout_ms": {
          "$ref": "#/$defs/TimeoutMs"
        },
        "on_error": {
          "$ref": "#/$defs/OnError",
          "description": "Inherits configuration.failure.on_error."
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "description": "One interceptor binding (section 7.7.4).",
      "additionalProperties": false
    },
    "Reference": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "description": "Grammar of a registered provider, resolver, redactor or binding id."
    },
    "InterceptionPoint": {
      "type": "string",
      "enum": [
        "agent_startup",
        "input",
        "pre_model_call",
        "post_model_call",
        "pre_tool_call",
        "post_tool_call",
        "output",
        "agent_shutdown"
      ],
      "description": "The closed set of agent lifecycle interception points (section 3).",
      "title": "Agent Hooks - interception point"
    },
    "Host": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "name"
      ],
      "description": "Optional and informative; never checked against code.",
      "additionalProperties": false
    },
    "Surface": {
      "anyOf": [
        {
          "$ref": "#/$defs/BufferedSurface"
        },
        {
          "$ref": "#/$defs/UnbufferedSurface"
        }
      ]
    },
    "BufferedSurface": {
      "type": "object",
      "properties": {
        "interception_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InterceptionPoint"
          },
          "minItems": 4,
          "maxItems": 8,
          "uniqueItems": true,
          "description": "Lifecycle points form the floor; model/tool points may be omitted in pairs."
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "uniqueItems": true
        },
        "profiles": {
          "$ref": "#/$defs/ProfileSupport"
        },
        "buffered_output": {
          "type": "boolean",
          "const": true,
          "default": true
        }
      },
      "description": "Buffered output is the default; exposure_bound must be absent.",
      "additionalProperties": false
    },
    "Capability": {
      "type": "string",
      "enum": [
        "model_calls",
        "tool_calls",
        "parallel_tool_calls",
        "streaming",
        "multi_turn",
        "int64_json",
        "bigint_json",
        "incremental_output",
        "host_declaration"
      ],
      "description": "Conformance capability vocabulary, with buffering declared separately."
    },
    "ProfileSupport": {
      "type": "object",
      "properties": {
        "sequential/first_deny": {
          "$ref": "#/$defs/FirstDenySupport"
        },
        "sequential/run_all": {
          "$ref": "#/$defs/RunAllSupport"
        },
        "parallel/strictest": {
          "$ref": "#/$defs/StrictestSupport"
        },
        "parallel/unanimous": {
          "$ref": "#/$defs/UnanimousSupport"
        }
      },
      "description": "Only the knobs a profile consults may appear.",
      "additionalProperties": false
    },
    "FirstDenySupport": {
      "type": "object",
      "properties": {
        "on_approval": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OnApproval"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "RunAllSupport": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "StrictestSupport": {
      "type": "object",
      "properties": {
        "on_transform_conflict": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConflictResolution"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "UnanimousSupport": {
      "type": "object",
      "properties": {
        "on_disagreement": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConflictResolution"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "UnbufferedSurface": {
      "type": "object",
      "properties": {
        "interception_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InterceptionPoint"
          },
          "minItems": 4,
          "maxItems": 8,
          "uniqueItems": true,
          "description": "Lifecycle points form the floor; model/tool points may be omitted in pairs."
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "uniqueItems": true
        },
        "profiles": {
          "$ref": "#/$defs/ProfileSupport"
        },
        "buffered_output": {
          "type": "boolean",
          "const": false
        },
        "exposure_bound": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "buffered_output",
        "exposure_bound"
      ],
      "description": "Streaming output must explicitly declare its exposure bound.",
      "additionalProperties": false
    },
    "Extensions": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {},
      "description": "Namespaced extensions (section 4.6); values are unconstrained JSON.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  }
}
