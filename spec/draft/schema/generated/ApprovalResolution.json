{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://responsibleai.github.io/agent-hooks/schema/draft/ApprovalResolution.json",
    "anyOf": [
        {
            "$ref": "#/$defs/ApproveResolution"
        },
        {
            "$ref": "#/$defs/RejectResolution"
        },
        {
            "$ref": "#/$defs/UnresolvedResolution"
        }
    ],
    "description": "What the resolver returns (§9).",
    "title": "Agent Hooks approval resolution",
    "$defs": {
        "ApproveResolution": {
            "type": "object",
            "properties": {
                "context_identity": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "MUST equal the request's context_identity byte for byte (echo rule, §9);\nnull echoes as null."
                },
                "outcome": {
                    "type": "string",
                    "const": "approve"
                },
                "verdict": {
                    "$ref": "#/$defs/AllowVerdict"
                }
            },
            "required": [
                "context_identity",
                "outcome",
                "verdict"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "approve: the resolver lifts the deny with an allow verdict."
        },
        "RejectResolution": {
            "type": "object",
            "properties": {
                "context_identity": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "MUST equal the request's context_identity byte for byte (echo rule, §9);\nnull echoes as null."
                },
                "outcome": {
                    "type": "string",
                    "const": "reject"
                },
                "verdict": {
                    "$ref": "#/$defs/DenyVerdict"
                }
            },
            "required": [
                "context_identity",
                "outcome",
                "verdict"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "reject: the resolver keeps a deny."
        },
        "UnresolvedResolution": {
            "type": "object",
            "properties": {
                "context_identity": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "MUST equal the request's context_identity byte for byte (echo rule, §9);\nnull echoes as null."
                },
                "outcome": {
                    "type": "string",
                    "const": "unresolved"
                }
            },
            "required": [
                "context_identity",
                "outcome"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "unresolved: no decision; the deny stands and no verdict is carried."
        },
        "AllowVerdict": {
            "type": "object",
            "properties": {
                "reason": {
                    "type": "string",
                    "pattern": "^(?!host_error:).*",
                    "description": "Interceptor-supplied machine identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11)."
                },
                "message": {
                    "type": "string",
                    "description": "Human-readable text for the caller."
                },
                "warnings": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Warning"
                    },
                    "description": "Recorded concerns that do not affect control flow (§5.1). Permitted on any\ndecision; unioned across an emission's verdicts (§7.3). Reasons starting with\nhost_warning: are reserved for the host (§11.1)."
                },
                "evidence": {
                    "$ref": "#/$defs/Evidence"
                },
                "result_labels": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Interceptor-supplied labels the host MUST persist with the produced data and\nresurface on later interception points (§5.4)."
                },
                "decision": {
                    "type": "string",
                    "const": "allow"
                }
            },
            "required": [
                "decision"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "allow: proceed. Absorbs warn through warnings[] (§5.1)."
        },
        "DenyVerdict": {
            "type": "object",
            "properties": {
                "reason": {
                    "type": "string",
                    "pattern": "^(?!host_error:).*",
                    "description": "Interceptor-supplied machine identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11)."
                },
                "message": {
                    "type": "string",
                    "description": "Human-readable text for the caller."
                },
                "warnings": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Warning"
                    },
                    "description": "Recorded concerns that do not affect control flow (§5.1). Permitted on any\ndecision; unioned across an emission's verdicts (§7.3). Reasons starting with\nhost_warning: are reserved for the host (§11.1)."
                },
                "evidence": {
                    "$ref": "#/$defs/Evidence"
                },
                "result_labels": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Interceptor-supplied labels the host MUST persist with the produced data and\nresurface on later interception points (§5.4)."
                },
                "decision": {
                    "type": "string",
                    "const": "deny"
                },
                "approval": {
                    "$ref": "#/$defs/JsonObject",
                    "description": "Present only on deny: marks the deny as liftable by the approval seam (§9).\nMAY be empty; reserved for approver-facing parameters."
                }
            },
            "required": [
                "decision"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "deny: stop the action. Absorbs escalate through the approval block (§5.1)."
        },
        "Warning": {
            "type": "object",
            "properties": {
                "reason": {
                    "type": "string",
                    "pattern": "^(?!host_error:|host_warning:).*",
                    "description": "Interceptor-supplied warning identifier. The host_error: prefix is reserved\nfor host-synthesized failures (§11) and host_warning: for host-synthesized\nwarnings (§11.1); an interceptor warning with either prefix fails §5\nvalidation."
                },
                "message": {
                    "type": "string"
                }
            },
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "A recorded concern that does not affect control flow (§5.1)."
        },
        "Evidence": {
            "type": "object",
            "properties": {
                "artefact": {
                    "type": "string",
                    "description": "Content address (sha256:<hex>) or URI of an offline-verifiable proof."
                },
                "verification_pointers": {
                    "$ref": "#/$defs/VerificationPointers"
                }
            },
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Offline-verifiable evidence attached to a verdict (§14)."
        },
        "JsonObject": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {},
            "description": "An open JSON object, not an arbitrary JSON value."
        },
        "VerificationPointers": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {
                "type": "string"
            },
            "description": "Named URIs an auditor MAY consult. Hosts MUST NOT dereference automatically (§14)."
        }
    }
}