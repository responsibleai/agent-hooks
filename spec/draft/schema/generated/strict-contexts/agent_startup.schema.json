{
  "$id": "https://responsibleai.github.io/agent-hooks/schema/draft/agent-context/agent_startup.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks — agent context (agent_startup)",
  "description": "Required+conditional schema for interception_point=agent_startup (AGENT-HOOKS-0.1 §4.2). Used by the CTK for strict validation.",
  "type": "object",
  "properties": {
    "spec": {
      "type": "string",
      "const": "agent-hooks/draft",
      "description": "This bundle's wire string, rewritten when a specification is cut."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "agent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "framework"
      ]
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id"
      ]
    },
    "trace": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        }
      }
    },
    "tenant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        }
      }
    },
    "budgets": {
      "type": "object",
      "properties": {
        "tool_call_count": {
          "type": "number"
        },
        "token_count": {
          "type": "number"
        },
        "elapsed_seconds": {
          "type": "number"
        },
        "cost_usd": {
          "type": "number"
        }
      }
    },
    "interception_point": {
      "type": "string",
      "const": "agent_startup"
    },
    "extensions": {
      "$ref": "#/$defs/Extensions"
    },
    "agent_init": {
      "$ref": "#/$defs/AgentInit"
    }
  },
  "required": [
    "spec",
    "timestamp",
    "sequence",
    "agent",
    "session",
    "interception_point",
    "agent_init"
  ],
  "$defs": {
    "ActorKind": {
      "type": "string",
      "enum": [
        "human",
        "service",
        "agent"
      ]
    },
    "AgentInit": {
      "type": "object",
      "properties": {
        "tools_registered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "tools_registered"
      ],
      "description": "Conditional payload of agent_startup (section 4.2).",
      "additionalProperties": false
    },
    "Extensions": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {},
      "description": "Namespaced extensions (section 4.6); values are unconstrained JSON.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  }
}
