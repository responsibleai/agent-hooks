{
  "$id": "https://responsibleai.github.io/agent-hooks/schema/draft/agent-context/post_model_call.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks — agent context (post_model_call)",
  "description": "Required+conditional schema for interception_point=post_model_call (AGENT-HOOKS-0.1 §4.2). Used by the CTK for strict validation.",
  "type": "object",
  "properties": {
    "spec": {
      "type": "string",
      "const": "agent-hooks/draft",
      "description": "This version's wire string (§4.1). A released version's contexts\ncarry that version's own string, agent-hooks/<major>.<minor>."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "agent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "framework"
      ]
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id"
      ]
    },
    "trace": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        }
      }
    },
    "tenant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        }
      }
    },
    "budgets": {
      "type": "object",
      "properties": {
        "tool_call_count": {
          "type": "number"
        },
        "token_count": {
          "type": "number"
        },
        "elapsed_seconds": {
          "type": "number"
        },
        "cost_usd": {
          "type": "number"
        }
      }
    },
    "interception_point": {
      "type": "string",
      "const": "post_model_call"
    },
    "extensions": {
      "$ref": "#/$defs/Extensions"
    },
    "model": {
      "$ref": "#/$defs/Model"
    },
    "response": {
      "$ref": "#/$defs/Response"
    },
    "request_id": {
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "required": [
    "spec",
    "timestamp",
    "sequence",
    "agent",
    "session",
    "interception_point",
    "model",
    "response"
  ],
  "$defs": {
    "ActorKind": {
      "type": "string",
      "enum": [
        "human",
        "service",
        "agent"
      ],
      "description": "Who acts (§4.5)."
    },
    "Extensions": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {},
      "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "JsonObject": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {},
      "description": "An open JSON object, not an arbitrary JSON value."
    },
    "Model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "id"
      ],
      "description": "Conditional payload of pre_model_call and post_model_call (§4.2).",
      "additionalProperties": false
    },
    "Response": {
      "type": "object",
      "properties": {
        "content": {},
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolCallRequest"
          }
        },
        "finish_reason": {
          "type": "string"
        }
      },
      "required": [
        "content",
        "tool_calls",
        "finish_reason"
      ],
      "description": "Conditional payload of post_model_call (§4.2).",
      "additionalProperties": false
    },
    "ToolCallRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "args": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "name",
        "args"
      ],
      "description": "One tool call the model asked for (§4.2)."
    },
    "Usage": {
      "type": "object",
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Token usage of a model call (§4.3)."
    }
  }
}
