{
  "$id": "https://responsibleai.github.io/agent-hooks/schema/draft/agent-context/agent_shutdown.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks — agent context (agent_shutdown)",
  "description": "Required+conditional schema for interception_point=agent_shutdown (AGENT-HOOKS-0.1 §4.2). Used by the CTK for strict validation.",
  "type": "object",
  "properties": {
    "interception_point": {
      "type": "string",
      "const": "agent_shutdown"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "extensions": {
      "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
      "$ref": "#/$defs/Extensions"
    },
    "spec": {
      "description": "This version's wire string (§4.1). A released version's contexts\ncarry that version's own string, agent-hooks/<major>.<minor>.",
      "type": "string",
      "const": "agent-hooks/draft"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "type": "integer"
    },
    "agent": {
      "type": "object",
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "framework": {
          "pattern": "^[a-z0-9_-]+$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "framework",
        "id"
      ]
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        },
        "turn": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id"
      ]
    },
    "trace": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        }
      }
    },
    "tenant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "description": "Who acts (§4.5).",
          "enum": [
            "agent",
            "human",
            "service"
          ],
          "type": "string"
        }
      }
    },
    "budgets": {
      "type": "object",
      "properties": {
        "tool_call_count": {
          "type": "number"
        },
        "token_count": {
          "type": "number"
        },
        "elapsed_seconds": {
          "type": "number"
        },
        "cost_usd": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "agent",
    "interception_point",
    "sequence",
    "session",
    "spec",
    "summary",
    "timestamp"
  ],
  "$defs": {
    "Extensions": {
      "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "type": "object",
      "additionalProperties": {}
    },
    "Summary": {
      "description": "Conditional payload of agent_shutdown (§4.2).",
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/$defs/SummaryReason"
        },
        "tool_calls": {
          "minimum": 0,
          "type": "integer"
        },
        "errors": {
          "minimum": 0,
          "type": "integer"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    "SummaryReason": {
      "description": "Why the agent stopped (§4.2).",
      "type": "string",
      "enum": [
        "completed",
        "error",
        "cancelled"
      ]
    }
  }
}
