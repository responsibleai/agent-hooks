{
  "$id": "https://responsibleai.github.io/agent-hooks/schema/draft/agent-context/pre_model_call.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks — agent context (pre_model_call)",
  "description": "Required+conditional schema for interception_point=pre_model_call (AGENT-HOOKS-0.1 §4.2). Used by the CTK for strict validation.",
  "type": "object",
  "properties": {
    "spec": {
      "type": "string",
      "const": "agent-hooks/draft",
      "description": "This bundle's wire string, rewritten when a specification is cut."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "agent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "framework"
      ]
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id"
      ]
    },
    "trace": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        }
      }
    },
    "tenant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        }
      }
    },
    "budgets": {
      "type": "object",
      "properties": {
        "tool_call_count": {
          "type": "number"
        },
        "token_count": {
          "type": "number"
        },
        "elapsed_seconds": {
          "type": "number"
        },
        "cost_usd": {
          "type": "number"
        }
      }
    },
    "interception_point": {
      "type": "string",
      "const": "pre_model_call"
    },
    "extensions": {
      "$ref": "#/$defs/Extensions"
    },
    "model": {
      "$ref": "#/$defs/Model"
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Message"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ToolDecl"
      }
    },
    "request_id": {
      "type": "string"
    }
  },
  "required": [
    "spec",
    "timestamp",
    "sequence",
    "agent",
    "session",
    "interception_point",
    "model",
    "messages"
  ],
  "$defs": {
    "ActorKind": {
      "type": "string",
      "enum": [
        "human",
        "service",
        "agent"
      ]
    },
    "Extensions": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {},
      "description": "Namespaced extensions (section 4.6); values are unconstrained JSON.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "JsonObject": {
      "type": "object",
      "properties": {},
      "description": "An open JSON object, not an arbitrary JSON value."
    },
    "Message": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "content": {}
      },
      "required": [
        "role",
        "content"
      ]
    },
    "Model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "ToolDecl": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "schema": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": [
        "name"
      ]
    }
  }
}
