{
  "$id": "https://responsibleai.github.io/agent-hooks/schema/v0.1/agent-context/pre_model_call.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Hooks — agent context (pre_model_call)",
  "description": "Closed required+conditional schema for interception_point=pre_model_call (AGENT-HOOKS-0.1 §4.2). Used by the CTK for strict validation.",
  "type": "object",
  "properties": {
    "interception_point": {
      "type": "string",
      "const": "pre_model_call"
    },
    "model": {
      "$ref": "#/$defs/Model"
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Message"
      }
    },
    "spec": {
      "pattern": "^agent-hooks/\\d+\\.\\d+$",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "type": "integer"
    },
    "agent": {
      "$ref": "#/$defs/AgentMetadata"
    },
    "session": {
      "$ref": "#/$defs/SessionMetadata"
    },
    "extensions": {
      "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
      "$ref": "#/$defs/Extensions"
    }
  },
  "required": [
    "agent",
    "interception_point",
    "messages",
    "model",
    "sequence",
    "session",
    "spec",
    "timestamp"
  ],
  "additionalProperties": false,
  "$defs": {
    "AgentMetadata": {
      "description": "Shared metadata present at every interception point.",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "framework": {
          "pattern": "^[a-z0-9_-]+$",
          "type": "string"
        }
      },
      "required": [
        "framework",
        "id"
      ]
    },
    "Extensions": {
      "description": "Namespaced extensions (§4.6): any value under a key that follows the\nnamespace rule.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "type": "object",
      "additionalProperties": {}
    },
    "JsonObject": {
      "description": "A JSON object with arbitrary JSON-valued members.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "JsonValue": {
      "description": "JSON data carried by hook payloads.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "$ref": "#/$defs/JsonObject"
        },
        {
          "type": [
            "null",
            "string",
            "number",
            "boolean"
          ]
        }
      ]
    },
    "Message": {
      "description": "One message of the model request (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "content",
        "role"
      ]
    },
    "Model": {
      "description": "Conditional payload of pre_model_call and post_model_call (§4.2).",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "SessionMetadata": {
      "description": "Shared session identity present at every interception point.",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    }
  }
}
