{
  "declaration": "agent-hooks-declaration/1.1",
  "spec": "agent-hooks/draft",
  "id": "streaming-document-policy",
  "surface": {
    "interception_points": [
      "agent_startup",
      "input",
      "output",
      "agent_shutdown"
    ],
    "capabilities": ["incremental_output", "host_declaration"],
    "declaration_versions": ["agent-hooks-declaration/1.1"],
    "profiles": {
      "sequential/first_deny": {
        "on_approval": ["resume"]
      }
    },
    "buffered_output": false,
    "exposure_bound": "Only public policy text is released as it is generated."
  },
  "bindings": [
    {
      "id": "document-policy",
      "kind": "example.document_policy",
      "at": ["output"]
    }
  ]
}
