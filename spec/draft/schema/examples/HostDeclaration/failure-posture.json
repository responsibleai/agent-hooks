{
  "spec": "agent-hooks/draft",
  "id": "document-policy-failure-posture",
  "configuration": {
    "composition": {
      "profile": "sequential/first_deny",
      "on_approval": "resume"
    },
    "failure": {
      "on_error": "deny"
    },
    "timeouts": {
      "interceptor_ms": 2000
    }
  },
  "surface": {
    "interception_points": [
      "agent_startup",
      "input",
      "pre_model_call",
      "post_model_call",
      "pre_tool_call",
      "post_tool_call",
      "output",
      "agent_shutdown"
    ],
    "capabilities": ["model_calls", "tool_calls", "host_declaration"],
    "profiles": {
      "sequential/first_deny": {
        "on_approval": ["resume"]
      }
    }
  },
  "bindings": [
    {
      "id": "document-policy",
      "kind": "example.document_policy",
      "config": {
        "permitted_collection": "public"
      },
      "timeout_ms": 1000,
      "on_error": "continue"
    }
  ]
}
