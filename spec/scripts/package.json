{
  "name": "agent-hooks-spec-scripts",
  "private": true,
  "scripts": {
    "build:reference": "pnpm --dir reference-docs run build",
    "generate:reference": "pnpm run build:reference && tsx generate-reference.mts",
    "check:reference": "pnpm run build:reference && tsx generate-reference.mts --check",
    "test:reference": "pnpm run build:reference && node --test reference-docs/test/*.test.mjs",
    "generate:schema": "pnpm run build:reference && tsx generate-schemas.mts",
    "check:schema": "pnpm run build:reference && tsx generate-schemas.mts --check",
    "check:schema:equivalence": "pnpm run build:reference && tsx schema-equivalence.mts"
  },
  "devDependencies": {
    "@agent-hooks/reference-docs": "workspace:*",
    "@typespec/compiler": "1.18.0",
    "@typespec/json-schema": "1.18.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-json-schema": "0.68.0"
  },
  "engines": {
    "node": ">=22"
  }
}
